<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns="https://schemas.zernova.dev/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:http="https://schemas.zernova.dev/http"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
               https://schemas.zernova.dev/http https://schemas.zernova.dev/http/current/zernova-http.xsd">

    <http:listener-config name="httpListenerConfig">
        <http:listener-connection host="0.0.0.0" port="${httpPort}"/>
    </http:listener-config>

    <flow name="main">
        <http:listener path="/" config-ref-invalid-name="httpListenerConfig"/>
        <logger/>
    </flow>
</zernova>
