<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns="https://schemas.zernova.dev/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:http="https://schemas.zernova.dev/http"
      xmlns:sc="https://schemas.zernova.dev/module-using-core"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
               https://schemas.zernova.dev/http https://schemas.zernova.dev/http/current/zernova-http.xsd
               https://schemas.zernova.dev/module-using-core https://schemas.zernova.dev/module-using-core/current/zernova-module-using-core.xsd">

    <flow name="main">
        <http:listener path="/" config-ref="httpListenerConfig"/>
        <sc:echo-set-payload config-ref="moduleConfig"/>
    </flow>

