<?xml version="1.0" encoding="UTF-8"?>
<module name="module-using-core"
        doc:description="This module relies entirely in runtime provided components (no other Plugin dependencies)"

        xmlns="https://schemas.zernova.dev/module"
        xmlns:zernova="https://schemas.zernova.dev/core"
        xmlns:doc="https://schemas.zernova.dev/documentation"
        xmlns:tns="https://schemas.zernova.dev/module-using-core"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           https://schemas.zernova.dev/module https://schemas.zernova.dev/module/current/zernova-module.xsd
           https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
           https://schemas.zernova.dev/module-using-core https://schemas.zernova.dev/module-using-core/current/zernova-module-using-core.xsd">

    <property name="echoMessage" type="string"/>

    <operation name="echo-set-payload" doc:description="Sets the payload to parametrized value">
        <body>
            <zernova:set-payload value="#[vars.echoMessage]" mimeType="text/plain" encoding="UTF-8"/>
        </body>
        <output type="string" doc:description="Payload's output"/>
    </operation>

 </module>
