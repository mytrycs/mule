<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:http="https://schemas.zernova.dev/http"
      xmlns="https://schemas.zernova.dev/core"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
                          https://schemas.zernova.dev/http https://schemas.zernova.dev/http/current/zernova-http.xsd">

    <http:listener-config name="lisConfig">
        <http:listener-connection host="localhost" port="${httpPort}" protocol="HTTP"/>
    </http:listener-config>

    <flow name="echoFlow">
        <http:listener path="/" config-ref="lisConfig"/>
        <logger message="This log message should be intercepted..." category="com.mycompany"/>
    </flow>
</zernova>
