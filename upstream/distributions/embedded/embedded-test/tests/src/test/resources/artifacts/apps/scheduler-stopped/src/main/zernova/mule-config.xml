<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns="https://schemas.zernova.dev/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:file="https://schemas.zernova.dev/file"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
               https://schemas.zernova.dev/file https://schemas.zernova.dev/file/current/zernova-file.xsd">

    <flow name="schedulerFlow">
        <scheduler>
            <scheduling-strategy>
                <fixed-frequency frequency="100" startDelay="0"/>
            </scheduling-strategy>
        </scheduler>
        <file:write path="${file.path}">
            <file:content>Hello World!</file:content>
        </file:write>
    </flow>
</zernova>
