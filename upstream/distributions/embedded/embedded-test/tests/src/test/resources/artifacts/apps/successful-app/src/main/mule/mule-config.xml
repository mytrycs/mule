<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns="https://schemas.zernova.dev/core" xmlns:http="https://schemas.zernova.dev/http"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
                          https://schemas.zernova.dev/http https://schemas.zernova.dev/http/current/zernova-http.xsd">

    <http:listener-config name="listener-config">
        <http:listener-connection host="0.0.0.0" port="${isAlivePort}"/>
    </http:listener-config>

    <flow name="listener">
        <http:listener path="/test" config-ref="listener-config"/>
        <set-payload value="ok"/>
    </flow>

</zernova>
