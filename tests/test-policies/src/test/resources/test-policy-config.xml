<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:test-policy="https://schemas.zernova.dev/test-policy"
      xmlns:some="https://schemas.zernova.dev/some"
      xmlns="https://schemas.zernova.dev/core"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
               https://schemas.zernova.dev/test-policy https://schemas.zernova.dev/test-policy/current/zernova-test-policy.xsd
               https://schemas.zernova.dev/some https://schemas.zernova.dev/some/current/zernova-some.xsd">

    <object name="disposeListener" class="com.zernova.test.policy.PolicyTestCase$DisposeListenerMessageProcessor"/>

    <flow name="main" initialState="stopped">
        <some:some-emitting-source message="hello dog!" times="1"/>
        <logger level="ERROR" message="#[payload]"/>
        <flow-ref name="disposeListener"/>
    </flow>

    <test-policy:proxy name="policy">
        <test-policy:source>
            <set-variable variableName="sourceState" value="before"/>
            <test-policy:execute-next/>
            <set-variable variableName="sourceState" value="after"/>
        </test-policy:source>
        <test-policy:operation>
            <set-variable variableName="requestState" value="before"/>
            <test-policy:execute-next/>
            <set-variable variableName="requestState" value="after"/>
        </test-policy:operation>
    </test-policy:proxy>
</zernova>
