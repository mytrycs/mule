<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<xsd:schema xmlns="https://schemas.zernova.dev/test-processor-chains"
            xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:zernova="https://schemas.zernova.dev/core"
            xmlns:spring="http://www.springframework.org/schema/beans"
            targetNamespace="https://schemas.zernova.dev/test-processor-chains"
            elementFormDefault="qualified"
            attributeFormDefault="unqualified">

    <xsd:import namespace="http://www.w3.org/XML/1998/namespace"/>
    <xsd:import namespace="https://schemas.zernova.dev/core"
                schemaLocation="https://schemas.zernova.dev/core/current/zernova.xsd"/>

    <xsd:element name="composite-processor-chain-router" type="compositeProcessorChainRouterType" substitutionGroup="zernova:abstract-extension"/>

    <xsd:complexType name="compositeProcessorChainRouterType">
        <xsd:complexContent>
            <xsd:extension base="zernova:abstractExtensionType">
                <xsd:sequence>
                    <xsd:element name="chain" minOccurs="1" maxOccurs="unbounded">
                        <xsd:complexType>
                            <xsd:sequence>
                                <xsd:group ref="zernova:messageProcessorOrMixedContentMessageProcessor" minOccurs="1" maxOccurs="unbounded"/>
                            </xsd:sequence>
                        </xsd:complexType>
                    </xsd:element>
                </xsd:sequence>
                <xsd:attribute name="name" type="xsd:string" use="required"/>
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>

    <xsd:element name="processor-chain-router" type="processorChainRouterType" substitutionGroup="zernova:abstract-extension"/>

    <xsd:complexType name="processorChainRouterType">
        <xsd:complexContent>
            <xsd:extension base="zernova:abstractExtensionType">
                <xsd:sequence>
                    <xsd:group ref="zernova:messageProcessorOrMixedContentMessageProcessor" minOccurs="1" maxOccurs="unbounded"/>
                </xsd:sequence>
                <xsd:attribute name="name" type="xsd:string" use="required"/>
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>

</xsd:schema>
