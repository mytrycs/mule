<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns="https://schemas.zernova.dev/core" xmlns:http="https://schemas.zernova.dev/http"
         xmlns:doc="https://schemas.zernova.dev/documentation" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd https://schemas.zernova.dev/http https://schemas.zernova.dev/http/current/zernova-http.xsd">
  <configuration-properties file="application.properties"/>
  <http:listener-config name="HTTP_Listener_config">
    <http:listener-connection protocol="HTTP" host="localhost" port="18082"/>
  </http:listener-config>
  <flow name="transformFlow">
    <http:listener config-ref="HTTP_Listener_config" path="/transform" allowedMethods="GET" doc:name="HTTP Listener" doc:id="bb6c9cb1-090f-42fb-93d5-d9951a216326">
      <http:response statusCode="200">
        <http:body>#[payload]</http:body>
        <http:headers>#[{'Content-Type': 'application/json'}]</http:headers>
      </http:response>
    </http:listener>
    <set-payload doc:name="Transform Message" doc:id="38419d09-8613-45d8-8ca4-e671058d36cd" mimeType="application/json" value='#[%dw 2.0&#10;output application/json&#10;---&#10;{message: "Hello from ZERNOVA Transform", environment: p("zernova.env"), testId: attributes.queryParams.testId default "missing"}]'/>
  </flow>
</zernova>
