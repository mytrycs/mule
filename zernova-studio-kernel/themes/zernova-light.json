  "tokenColors": [
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#5b727c"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#9a552a"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.type",
        "keyword"
      ],
      "settings": {
        "foreground": "#176bb4"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name",
        "variable"
      ],
      "settings": {
        "foreground": "#226771"
      }
    }
