{
  "name": "zernova-studio-kernel-preview",
  "displayName": "ZERNOVA Studio",
  "description": "ZERNOVA Studio development alpha with bundled ZERNOVA Runtime and patched Java 17.",
  "version": "0.6.0",
  "publisher": "zernova-preview",
  "license": "SEE LICENSE IN LICENSE.txt",
  "private": true,
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=22.14.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ZERNOVA",
    "integration",
    "Mule Kernel"
  ],
  "icon": "assets/zernova-icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onWebviewPanel:zernovaKernelStudio.preview"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Design preview and editing are available. Runtime diagnostics, builds and execution require workspace trust."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Real projects require an accessible filesystem on the extension host."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "zernovaKernelStudio.openPreview",
        "category": "ZERNOVA",
        "title": "Open Studio Design Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "zernovaKernelStudio.resetPreview",
        "category": "ZERNOVA",
        "title": "Reset Studio Preview",
        "icon": "$(discard)"
      },
      {
        "command": "zernovaKernelStudio.resetLayout",
        "category": "ZERNOVA",
        "title": "Reset Studio Preview Layout",
        "icon": "$(layout)"
      },
      {
        "command": "zernovaKernelStudio.openScenario",
        "category": "ZERNOVA",
        "title": "Choose Studio Preview View"
      },
      {
        "command": "zernovaKernelStudio.newProject",
        "category": "ZERNOVA",
        "title": "New ZERNOVA Project",
        "icon": "$(new-folder)"
      },
      {
        "command": "zernovaKernelStudio.openProject",
        "category": "ZERNOVA",
        "title": "Open ZERNOVA Project",
        "icon": "$(folder-opened)"
      },
      {
        "command": "zernovaKernelStudio.newIntegration",
        "category": "ZERNOVA",
        "title": "New Integration XML",
        "icon": "$(new-file)"
      },
      {
        "command": "zernovaKernelStudio.openIntegration",
        "category": "ZERNOVA",
        "title": "Open Integration in Studio",
        "icon": "$(open-preview)"
      },
      {
        "command": "zernovaKernelStudio.configureRuntime",
        "category": "ZERNOVA",
        "title": "Bundled Runtime and Java",
        "icon": "$(settings-gear)"
      },
      {
        "command": "zernovaKernelStudio.diagnostics",
        "category": "ZERNOVA",
        "title": "Runtime Diagnostics",
        "icon": "$(checklist)"
      },
      {
        "command": "zernovaKernelStudio.build",
        "category": "ZERNOVA",
        "title": "Build Application",
        "icon": "$(tools)"
      },
      {
        "command": "zernovaKernelStudio.run",
        "category": "ZERNOVA",
        "title": "Build and Run Application",
        "icon": "$(play)"
      },
      {
        "command": "zernovaKernelStudio.status",
        "category": "ZERNOVA",
        "title": "Refresh Runtime Status",
        "icon": "$(refresh)"
      },
      {
        "command": "zernovaKernelStudio.logs",
        "category": "ZERNOVA",
        "title": "Show Application Logs",
        "icon": "$(output)"
      },
      {
        "command": "zernovaKernelStudio.stopApplication",
        "category": "ZERNOVA",
        "title": "Stop Application (Undeploy)",
        "icon": "$(debug-stop)"
      },
      {
        "command": "zernovaKernelStudio.stopRuntime",
        "category": "ZERNOVA",
        "title": "Stop Project Runtime",
        "icon": "$(debug-stop)"
      },
      {
        "command": "zernovaKernelStudio.cancel",
        "category": "ZERNOVA",
        "title": "Cancel Current Operation",
        "icon": "$(close)"
      },
      {
        "command": "zernovaKernelStudio.selectProject",
        "category": "ZERNOVA",
        "title": "Select Project"
      },
      {
        "command": "zernovaKernelStudio.importLegacyProject",
        "category": "ZERNOVA",
        "title": "Import Legacy XML Project"
      },
      {
        "command": "zernovaKernelStudio.debug",
        "category": "ZERNOVA",
        "title": "Debug Application (Java)",
        "icon": "$(debug-alt)"
      },
      {
        "command": "zernovaKernelStudio.configureRun",
        "category": "ZERNOVA",
        "title": "Run Configuration\u2026",
        "icon": "$(gear)"
      },
      {
        "command": "zernovaKernelStudio.manualSave",
        "title": "ZERNOVA: Save and Apply Redeploy Setting",
        "icon": "$(save)"
      },
      {
        "command": "zernovaKernelStudio.configureDebug",
        "title": "ZERNOVA: Debug Configuration",
        "icon": "$(gear)"
      },
      {
        "command": "zernovaKernelStudio.openFile",
        "category": "ZERNOVA",
        "title": "Open",
        "icon": "$(go-to-file)"
      },
      {
        "command": "zernovaKernelStudio.openText",
        "category": "ZERNOVA",
        "title": "Open in Text Editor",
        "icon": "$(code)"
      },
      {
        "command": "zernovaKernelStudio.openToSide",
        "category": "ZERNOVA",
        "title": "Open to the Side",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "zernovaKernelStudio.openPom",
        "category": "ZERNOVA",
        "title": "Open Maven POM",
        "icon": "$(file-code)"
      },
      {
        "command": "zernovaKernelStudio.copyPath",
        "category": "ZERNOVA",
        "title": "Copy Path",
        "icon": "$(copy)"
      },
      {
        "command": "zernovaKernelStudio.copyRelativePath",
        "category": "ZERNOVA",
        "title": "Copy Relative Path",
        "icon": "$(copy)"
      },
      {
        "command": "zernovaKernelStudio.revealFile",
        "category": "ZERNOVA",
        "title": "Reveal in Finder / File Manager",
        "icon": "$(folder-opened)"
      },
      {
        "command": "zernovaKernelStudio.revealExplorer",
        "category": "ZERNOVA",
        "title": "Reveal in Files Explorer",
        "icon": "$(files)"
      },
      {
        "command": "zernovaKernelStudio.findInFolder",
        "category": "ZERNOVA",
        "title": "Find in Folder\u2026",
        "icon": "$(search)"
      },
      {
        "command": "zernovaKernelStudio.refreshProject",
        "category": "ZERNOVA",
        "title": "Refresh Project and Dependencies",
        "icon": "$(refresh)"
      },
      {
        "command": "zernovaKernelStudio.manageDependencies",
        "category": "ZERNOVA",
        "title": "Manage Maven Dependencies\u2026",
        "icon": "$(library)"
      },
      {
        "command": "zernovaKernelStudio.removeDependency",
        "category": "ZERNOVA",
        "title": "Remove Dependency\u2026",
        "icon": "$(trash)"
      },
      {
        "command": "zernovaKernelStudio.removeProject",
        "category": "ZERNOVA",
        "title": "Remove Project from Studio",
        "icon": "$(close)"
      },
      {
        "command": "zernovaKernelStudio.newFile",
        "category": "ZERNOVA",
        "title": "New File\u2026",
        "icon": "$(new-file)"
      },
      {
        "command": "zernovaKernelStudio.newFolder",
        "category": "ZERNOVA",
        "title": "New Folder\u2026",
        "icon": "$(new-folder)"
      },
      {
        "command": "zernovaKernelStudio.renameFile",
        "category": "ZERNOVA",
        "title": "Rename\u2026",
        "icon": "$(edit)"
      },
      {
        "command": "zernovaKernelStudio.moveFile",
        "category": "ZERNOVA",
        "title": "Move\u2026",
        "icon": "$(arrow-right)"
      },
      {
        "command": "zernovaKernelStudio.deleteFile",
        "category": "ZERNOVA",
        "title": "Move to Trash\u2026",
        "icon": "$(trash)"
      },
      {
        "command": "zernovaKernelStudio.inspectArtifact",
        "category": "ZERNOVA",
        "title": "Artifact Details\u2026",
        "icon": "$(package)"
      },
      {
        "command": "zernovaKernelStudio.revealArtifact",
        "category": "ZERNOVA",
        "title": "Reveal Artifact in Finder / File Manager",
        "icon": "$(folder-opened)"
      },
      {
        "command": "zernovaKernelStudio.cleanProject",
        "category": "ZERNOVA",
        "title": "Clean Build Output",
        "icon": "$(clear-all)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "zernovaKernelStudio",
          "title": "ZERNOVA",
          "icon": "assets/zernova-mark.svg"
        }
      ]
    },
    "views": {
      "zernovaKernelStudio": [
        {
          "id": "zernovaKernelStudio.projects",
          "name": "Projects",
          "contextualTitle": "ZERNOVA Studio"
        },
        {
          "id": "zernovaKernelStudio.previewViews",
          "name": "Design Preview",
          "contextualTitle": "ZERNOVA Studio"
        },
        {
          "id": "zernovaKernelStudio.runtimeInfo",
          "name": "Target Runtime",
          "contextualTitle": "ZERNOVA Studio"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "zernovaKernelStudio.newProject",
          "when": "view == zernovaKernelStudio.projects",
          "group": "navigation@1"
        },
        {
          "command": "zernovaKernelStudio.openProject",
          "when": "view == zernovaKernelStudio.projects",
          "group": "navigation@2"
        },
        {
          "command": "zernovaKernelStudio.newIntegration",
          "when": "view == zernovaKernelStudio.projects",
          "group": "navigation@3"
        },
        {
          "command": "zernovaKernelStudio.resetPreview",
          "when": "view == zernovaKernelStudio.previewViews",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "zernovaKernelStudio.openIntegration",
          "when": "view == zernovaKernelStudio.projects && viewItem == zernovaKernelStudio.integration",
          "group": "1_open@0"
        },
        {
          "command": "zernovaKernelStudio.openText",
          "when": "view == zernovaKernelStudio.projects && viewItem =~ /^zernovaKernelStudio\\.(file|integration)$/",
          "group": "1_open@1"
        },
        {
          "command": "zernovaKernelStudio.openToSide",
          "when": "view == zernovaKernelStudio.projects && viewItem =~ /^zernovaKernelStudio\\.(file|integration)$/",
          "group": "1_open@2"
        },
        {
          "submenu": "zernovaKernelStudio.newResource",
          "when": "view == zernovaKernelStudio.projects && viewItem =~ /^zernovaKernelStudio\\.(project|folder|file|integration)$/",
          "group": "2_new"
        },
        {
          "command": "zernovaKernelStudio.manualSave",
          "when": "view == zernovaKernelStudio.projects && viewItem =~ /^zernovaKernelStudio\\.(file|integration)$/",
          "group": "3_save"
        },
        {
          "submenu": "zernovaKernelStudio.runAs",
          "when": "view == zernovaKernelStudio.projects && viewItem =~ /^zernovaKernelStudio\\.(project|folder|file|integration)$/",
          "group": "4_execution@1"
        },
        {
          "submenu": "zernovaKernelStudio.debugAs",
          "when": "view == zernovaKernelStudio.projects && viewItem =~ /^zernovaKernelStudio\\.(project|folder|file|integration)$/",
          "group": "4_execution@2"
        },
        {
          "submenu": "zernovaKernelStudio.buildProject",
          "when": "view == zernovaKernelStudio.projects && viewItem =~ /^zernovaKernelStudio\\.(project|folder|file|integration)$/",
          "group": "4_execution@3"
        },
        {
          "command": "zernovaKernelStudio.logs",
          "when": "view == zernovaKernelStudio.projects && viewItem =~ /^zernovaKernelStudio\\.(project|folder|file|integration)$/",
          "group": "4_execution@4"
        },
        {
          "command": "zernovaKernelStudio.stopApplication",
          "when": "view == zernovaKernelStudio.projects && viewItem =~ /^zernovaKernelStudio\\.(project|folder|file|integration)$/",
          "group": "4_execution@5"
        },
        {
          "command": "zernovaKernelStudio.stopRuntime",
          "when": "view == zernovaKernelStudio.projects && viewItem =~ /^zernovaKernelStudio\\.(project|folder|file|integration)$/",
          "group": "4_execution@6"
        },
        {
          "submenu": "zernovaKernelStudio.maven",
          "when": "view == zernovaKernelStudio.projects && viewItem =~ /^zernovaKernelStudio\\.(project|folder|file|integration)$/ || (view == zernovaKernelStudio.projects && viewItem =~ /^zernovaKernelStudio\\.(dependencies|dependency|artifact|runtimeArtifacts|projectArtifacts)$/)",
          "group": "5_dependencies"
        },
        {
          "command": "zernovaKernelStudio.removeDependency",
          "when": "view == zernovaKernelStudio.projects && viewItem == zernovaKernelStudio.dependency",
          "group": "5_dependencies@2"
        },
        {
          "command": "zernovaKernelStudio.inspectArtifact",
          "when": "view == zernovaKernelStudio.projects && viewItem =~ /^zernovaKernelStudio\\.(dependency|artifact)$/",
          "group": "1_open@0"
        },
        {
          "command": "zernovaKernelStudio.revealArtifact",
          "when": "view == zernovaKernelStudio.projects && viewItem =~ /^zernovaKernelStudio\\.(dependency|artifact)$/",
          "group": "1_open@1"
        },
        {
          "command": "zernovaKernelStudio.findInFolder",
          "when": "view == zernovaKernelStudio.projects && viewItem =~ /^zernovaKernelStudio\\.(project|folder)$/",
          "group": "6_find"
        },
        {
          "command": "zernovaKernelStudio.renameFile",
          "when": "view == zernovaKernelStudio.projects && viewItem =~ /^zernovaKernelStudio\\.(folder|file|integration)$/",
          "group": "7_resource@1"
        },
        {
          "command": "zernovaKernelStudio.moveFile",
          "when": "view == zernovaKernelStudio.projects && viewItem =~ /^zernovaKernelStudio\\.(folder|file|integration)$/",
          "group": "7_resource@2"
        },
        {
          "command": "zernovaKernelStudio.deleteFile",
          "when": "view == zernovaKernelStudio.projects && viewItem =~ /^zernovaKernelStudio\\.(folder|file|integration)$/",
          "group": "7_resource@3"
        },
        {
          "command": "zernovaKernelStudio.copyPath",
          "when": "view == zernovaKernelStudio.projects && viewItem =~ /^zernovaKernelStudio\\.(project|folder|file|integration)$/",
          "group": "8_paths@1"
        },
        {
          "command": "zernovaKernelStudio.copyRelativePath",
          "when": "view == zernovaKernelStudio.projects && viewItem =~ /^zernovaKernelStudio\\.(project|folder|file|integration)$/",
          "group": "8_paths@2"
        },
        {
          "submenu": "zernovaKernelStudio.showIn",
          "when": "view == zernovaKernelStudio.projects && viewItem =~ /^zernovaKernelStudio\\.(project|folder|file|integration)$/",
          "group": "8_paths@3"
        },
        {
          "command": "zernovaKernelStudio.refreshProject",
          "when": "view == zernovaKernelStudio.projects && viewItem =~ /^zernovaKernelStudio\\.(project|folder|file|integration)$/",
          "group": "9_project@1"
        },
        {
          "command": "zernovaKernelStudio.removeProject",
          "when": "view == zernovaKernelStudio.projects && viewItem == zernovaKernelStudio.project",
          "group": "9_project@2"
        }
      ],
      "editor/context": [
        {
          "command": "zernovaKernelStudio.manualSave",
          "when": "resourcePath =~ /src[\\\\/]main[\\\\/]|[\\\\/]pom\\.xml$|[\\\\/]zernova-(app|artifact)\\.json$/",
          "group": "9_zernova@-1"
        },
        {
          "command": "zernovaKernelStudio.run",
          "when": "resourceExtname == .xml && resourcePath =~ /src[\\\\/]main[\\\\/]zernova[\\\\/]/",
          "group": "9_zernova@0"
        },
        {
          "command": "zernovaKernelStudio.debug",
          "when": "resourceExtname == .xml && resourcePath =~ /src[\\\\/]main[\\\\/]zernova[\\\\/]/",
          "group": "9_zernova@1"
        },
        {
          "command": "zernovaKernelStudio.configureRun",
          "when": "resourceExtname == .xml && resourcePath =~ /src[\\\\/]main[\\\\/]zernova[\\\\/]/",
          "group": "9_zernova@2"
        },
        {
          "command": "zernovaKernelStudio.build",
          "when": "resourceExtname == .xml && resourcePath =~ /src[\\\\/]main[\\\\/]zernova[\\\\/]/",
          "group": "9_zernova@3"
        },
        {
          "command": "zernovaKernelStudio.logs",
          "when": "resourceExtname == .xml && resourcePath =~ /src[\\\\/]main[\\\\/]zernova[\\\\/]/",
          "group": "9_zernova@4"
        },
        {
          "command": "zernovaKernelStudio.stopRuntime",
          "when": "resourceExtname == .xml && resourcePath =~ /src[\\\\/]main[\\\\/]zernova[\\\\/]/",
          "group": "9_zernova@5"
        },
        {
          "command": "zernovaKernelStudio.configureDebug",
          "when": "resourceExtname == .xml && resourcePath =~ /src[\\\\/]main[\\\\/]zernova[\\\\/]/",
          "group": "9_zernova@2a"
        }
      ],
      "zernovaKernelStudio.newResource": [
        {
          "command": "zernovaKernelStudio.newIntegration"
        },
        {
          "command": "zernovaKernelStudio.newFile"
        },
        {
          "command": "zernovaKernelStudio.newFolder"
        }
      ],
      "zernovaKernelStudio.runAs": [
        {
          "command": "zernovaKernelStudio.run",
          "group": "1"
        },
        {
          "command": "zernovaKernelStudio.configureRun",
          "group": "2"
        }
      ],
      "zernovaKernelStudio.debugAs": [
        {
          "command": "zernovaKernelStudio.debug",
          "group": "1"
        },
        {
          "command": "zernovaKernelStudio.configureDebug",
          "group": "2"
        }
      ],
      "zernovaKernelStudio.buildProject": [
        {
          "command": "zernovaKernelStudio.build",
          "group": "1"
        },
        {
          "command": "zernovaKernelStudio.cleanProject",
          "group": "2"
        },
        {
          "command": "zernovaKernelStudio.diagnostics",
          "group": "3"
        }
      ],
      "zernovaKernelStudio.maven": [
        {
          "command": "zernovaKernelStudio.manageDependencies",
          "group": "1"
        },
        {
          "command": "zernovaKernelStudio.openPom",
          "group": "2"
        },
        {
          "command": "zernovaKernelStudio.refreshProject",
          "group": "3"
        }
      ],
      "zernovaKernelStudio.showIn": [
        {
          "command": "zernovaKernelStudio.revealExplorer"
        },
        {
          "command": "zernovaKernelStudio.revealFile"
        }
      ],
      "explorer/context": [
        {
          "submenu": "zernovaKernelStudio.explorerProject",
          "when": "resourceScheme == file && resourcePath in zernovaKernelStudio.projectResources",
          "group": "7_zernova"
        }
      ],
      "zernovaKernelStudio.explorerProject": [
        {
          "command": "zernovaKernelStudio.newIntegration",
          "group": "1_new"
        },
        {
          "command": "zernovaKernelStudio.openIntegration",
          "when": "resourceExtname == .xml && resourcePath =~ /src[\\\\/]main[\\\\/]zernova[\\\\/]/",
          "group": "2_open"
        },
        {
          "command": "zernovaKernelStudio.run",
          "group": "3_run@1"
        },
        {
          "command": "zernovaKernelStudio.debug",
          "group": "3_run@2"
        },
        {
          "command": "zernovaKernelStudio.configureRun",
          "group": "3_run@3"
        },
        {
          "command": "zernovaKernelStudio.configureDebug",
          "group": "3_run@4"
        },
        {
          "command": "zernovaKernelStudio.build",
          "group": "4_build@1"
        },
        {
          "command": "zernovaKernelStudio.cleanProject",
          "group": "4_build@2"
        },
        {
          "command": "zernovaKernelStudio.manageDependencies",
          "group": "5_dependencies@1"
        },
        {
          "command": "zernovaKernelStudio.openPom",
          "group": "5_dependencies@2"
        },
        {
          "command": "zernovaKernelStudio.refreshProject",
          "group": "6_refresh"
        }
      ]
    },
    "themes": [
      {
        "label": "ZERNOVA Studio Light",
        "uiTheme": "vs",
        "path": "themes/zernova-light.json"
      },
      {
        "label": "ZERNOVA Studio Dark",
        "uiTheme": "vs-dark",
        "path": "themes/zernova-dark.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "zernovaKernelStudio.integration",
        "displayName": "ZERNOVA Integration",
        "selector": [
          {
            "filenamePattern": "**/src/main/zernova/*.xml"
          }
        ],
        "priority": "option"
      }
    ],
    "keybindings": [
      {
        "command": "zernovaKernelStudio.manualSave",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "editorTextFocus && resourcePath =~ /src[\\\\/]main[\\\\/]|[\\\\/]pom\\.xml$|[\\\\/]zernova-(app|artifact)\\.json$/"
      }
    ],
    "configuration": {
      "title": "ZERNOVA Studio",
      "properties": {
        "zernovaKernelStudio.redeployOnSave": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Rebuild and redeploy changed build inputs on explicit manual save, only while the app is deployed. Background XML autosaves never redeploy."
        }
      }
    },
    "submenus": [
      {
        "id": "zernovaKernelStudio.newResource",
        "label": "New"
      },
      {
        "id": "zernovaKernelStudio.runAs",
        "label": "Run As"
      },
      {
        "id": "zernovaKernelStudio.debugAs",
        "label": "Debug As"
      },
      {
        "id": "zernovaKernelStudio.buildProject",
        "label": "Build"
      },
      {
        "id": "zernovaKernelStudio.maven",
        "label": "Maven / Dependencies"
      },
      {
        "id": "zernovaKernelStudio.showIn",
        "label": "Show In"
      },
      {
        "id": "zernovaKernelStudio.explorerProject",
        "label": "ZERNOVA"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "vscode:prepublish": "npm run build && node scripts/verify-package.mjs",
    "package": "node scripts/package.mjs",
    "test:host": "node scripts/test-host.mjs",
    "test:ui": "node scripts/test-ui.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/vscode": "1.96.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "axe-core": "4.11.0",
    "esbuild": "0.28.2",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "marked": "18.1.2"
  },
  "dependencies": {
    "sax": "1.6.1"
  },
  "extensionKind": [
    "workspace"
  ]
}
