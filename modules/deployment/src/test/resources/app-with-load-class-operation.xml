<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns="https://schemas.zernova.dev/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:load-class="https://schemas.zernova.dev/load-class"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
                          https://schemas.zernova.dev/load-class https://schemas.zernova.dev/load-class/current/zernova-load-class.xsd">

    <flow name="flowWhichTriesToLoadTheClass">
        <load-class:try-load-class class="org.foo.EchoTest" />
    </flow>

    <flow name="flowWhichSavesTheCallbackAndLoadsClassesInErrorHandler">
        <load-class:save-completion-callback callback-key="SavedCallback" />
        <error-handler>
            <on-error-continue>
                <load-class:try-load-class class="org.foo.EchoTest" />
            </on-error-continue>
        </error-handler>
    </flow>

</zernova>
