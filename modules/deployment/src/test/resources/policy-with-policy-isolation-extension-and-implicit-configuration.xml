<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:test-policy="https://schemas.zernova.dev/test-policy"
      xmlns="https://schemas.zernova.dev/core"
      xmlns:policy-configuration="https://schemas.zernova.dev/policy-configuration"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
      https://schemas.zernova.dev/test-policy https://schemas.zernova.dev/test-policy/current/zernova-test-policy.xsd
      https://schemas.zernova.dev/policy-configuration https://schemas.zernova.dev/policy-configuration/current/zernova-policy-configuration.xsd">

    <test-policy:proxy name="policy-configuration-extension">
        <test-policy:operation>
                <test-policy:execute-next/>
                <test-policy:custom-processor class="com.zernova.runtime.module.deployment.test.internal.TestPolicyProcessor"/>
                <policy-configuration:check-implicit-configuration/>
        </test-policy:operation>
    </test-policy:proxy>
</zernova>
