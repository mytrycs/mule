<?xml version="1.0" encoding="UTF-8"?>
<module name="module-bye"
        namespace="https://schemas.zernova.dev/module-bye"
        xmlns="https://schemas.zernova.dev/module"
        xmlns:zernova="https://schemas.zernova.dev/core"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           https://schemas.zernova.dev/module https://schemas.zernova.dev/module/current/zernova-module.xsd
           https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd">

    <operation name="say-bye">
        <body>
            <zernova:set-payload value="bye bye"/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="custom-type-op">
        <!-- dummy operation to assert that on deployment, JAR plugins are properly read when discovering types -->
        <parameters>
            <parameter name="customParameter1" type="Type_same_folder"/>
            <parameter name="customParameter2" type="Type_sub_folder"/>
            <parameter name="customParameter3" type="Type_upper_folder"/>
        </parameters>
        <body>
            <zernova:set-payload value="bye bye"/>
        </body>
        <output type="string"/>
    </operation>


</module>
