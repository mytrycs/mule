<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xsd:schema xmlns="https://schemas.zernova.dev/exception"
            xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns:zernova="https://schemas.zernova.dev/core"
            targetNamespace="https://schemas.zernova.dev/exception"
            attributeFormDefault="unqualified"
            elementFormDefault="qualified">

    <xsd:import namespace="http://www.w3.org/XML/1998/namespace"/>
    <xsd:import namespace="https://schemas.zernova.dev/core"
                schemaLocation="https://schemas.zernova.dev/core/current/zernova.xsd"/>


    <xsd:element name="throw-exception" type="throwType" substitutionGroup="zernova:abstract-message-processor">
        <xsd:annotation>
            <xsd:documentation>
                Throws an instance of the exception defined.
            </xsd:documentation>
        </xsd:annotation>
    </xsd:element>

    <xsd:complexType name="throwType">
        <xsd:complexContent>
            <xsd:extension base="zernova:abstractMessageProcessorType">
                <xsd:attribute name="exceptionClassName" type="zernova:substitutableName" use="required">
                    <xsd:annotation>
                        <xsd:documentation>
                            A fully qualified classname of the exception object to throw.
                        </xsd:documentation>
                    </xsd:annotation>
                </xsd:attribute>
                <xsd:attribute name="error" type="zernova:errorIdentifierType" use="optional">
                    <xsd:annotation>
                        <xsd:documentation>
                            The mule error included in the exception thrown.
                        </xsd:documentation>
                    </xsd:annotation>
                </xsd:attribute>
            </xsd:extension>
        </xsd:complexContent>
    </xsd:complexType>
</xsd:schema>
