<?xml version="1.0" encoding="UTF-8"?>
<module name="module-using-bye"
        xmlns="https://schemas.zernova.dev/module"
        xmlns:module-bye="https://schemas.zernova.dev/module-bye"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           https://schemas.zernova.dev/module https://schemas.zernova.dev/module/current/zernova-module.xsd
           https://schemas.zernova.dev/module-bye https://schemas.zernova.dev/module-bye/current/zernova-module-bye.xsd">

    <operation name="adios">
        <body>
            <module-bye:say-bye/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="adios-again">
        <body>
            <module-bye:say-bye/>
        </body>
        <output type="string"/>
    </operation>

</module>
