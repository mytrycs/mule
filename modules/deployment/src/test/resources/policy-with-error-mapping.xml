<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:test-policy="https://schemas.zernova.dev/test-policy"
      xmlns="https://schemas.zernova.dev/core"
      xmlns:simple="https://schemas.zernova.dev/simple"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
               https://schemas.zernova.dev/test-policy https://schemas.zernova.dev/test-policy/current/zernova-test-policy.xsd
               https://schemas.zernova.dev/simple https://schemas.zernova.dev/simple/current/zernova-simple.xsd">

    <test-policy:proxy name="async-policy">
        <test-policy:operation>
            <try>
                <simple:fail>
                    <error-mapping sourceType="WITH-ERROR-DECLARATION:MY_DECLARED_ERROR"
                                   targetType="ZERNOVA:ANY"/>
                </simple:fail>
                <error-handler>
                    <on-error-continue type="ZERNOVA:ANY">
                        <test-policy:execute-next/>
                        <test-policy:custom-processor
                                class="com.zernova.runtime.module.deployment.test.internal.TestPolicyProcessor"/>
                    </on-error-continue>
                </error-handler>
            </try>
        </test-policy:operation>
    </test-policy:proxy>
</zernova>
