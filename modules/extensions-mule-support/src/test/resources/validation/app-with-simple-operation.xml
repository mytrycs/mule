<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:operation="https://schemas.zernova.dev/operation"
      xmlns="https://schemas.zernova.dev/core"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
        https://schemas.zernova.dev/operation https://schemas.zernova.dev/operation/current/zernova-operation.xsd">

    <!-- The operation DSL is only allowed if the property mule.experimental.enableMuleSdk is set to true -->
    <operation:def name="simpleOperation" >
        <operation:output>
            <operation:payload-type type="void" />
        </operation:output>
        <operation:body>
            <logger />
        </operation:body>
    </operation:def>
</zernova>
