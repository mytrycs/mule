<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:operation="https://schemas.zernova.dev/operation"
      xmlns="https://schemas.zernova.dev/core"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
          https://schemas.zernova.dev/operation https://schemas.zernova.dev/operation/current/zernova-operation.xsd">

    <operation:def name="deprecatedOperation">
        <operation:deprecated since="1.1.0"
                              message="Some deprecation message" />
        <operation:output>
            <operation:payload-type type="string"/>
        </operation:output>
        <operation:body>
            <set-payload value="Some deprecated value" />
        </operation:body>
    </operation:def>

    <operation:def name="operationWithDeprecatedParameter">
        <operation:parameters>
            <operation:parameter name="deprecatedParameter" type="string">
                <operation:deprecated since="1.1.0"
                                      message="Some deprecation message" />
            </operation:parameter>
        </operation:parameters>
        <operation:output>
            <operation:payload-type type="string"/>
        </operation:output>
        <operation:body>
            <set-payload value="Irrelevant" />
        </operation:body>
    </operation:def>
</zernova>
