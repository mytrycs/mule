<?xml version="1.0" encoding="UTF-8"?>
<extension xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:zernova="https://schemas.zernova.dev/core"
           xmlns:operation="https://schemas.zernova.dev/operation"
           xmlns:self-referencing="https://schemas.zernova.dev/self-referencing"
           xmlns="https://schemas.zernova.dev/mule-extension"
           xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
        https://schemas.zernova.dev/operation https://schemas.zernova.dev/operation/current/zernova-operation.xsd
        https://schemas.zernova.dev/self-referencing https://schemas.zernova.dev/self-referencing/current/zernova-self-referencing.xsd
        https://schemas.zernova.dev/mule-extension https://schemas.zernova.dev/mule-extension/current/zernova-extension.xsd">
    <description name="Self-Referencing Extension"/>

    <operation:def name="identityBetweenBraces">
        <operation:parameters>
            <operation:parameter name="input" type="any"/>
        </operation:parameters>
        <operation:output>
            <operation:payload-type type="any"/>
        </operation:output>
        <operation:body>
            <self-referencing:identity input="#[params.input]"/>
            <zernova:set-payload value="#['(' ++ payload ++ ')']"/>
        </operation:body>
    </operation:def>

    <operation:def name="identity">
        <operation:parameters>
            <operation:parameter name="input" type="any"/>
        </operation:parameters>
        <operation:output>
            <operation:payload-type type="any"/>
        </operation:output>
        <operation:body>
            <zernova:set-payload value="#[params.input]"/>
        </operation:body>
    </operation:def>
</extension>
