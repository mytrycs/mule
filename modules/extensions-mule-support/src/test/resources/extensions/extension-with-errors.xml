<?xml version="1.0" encoding="UTF-8"?>
<extension xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns="https://schemas.zernova.dev/mule-extension"
           xmlns:operation="https://schemas.zernova.dev/operation"
           xmlns:core="https://schemas.zernova.dev/core"
           xmlns:heisenberg="https://schemas.zernova.dev/heisenberg"
           xsi:schemaLocation="https://schemas.zernova.dev/mule-extension https://schemas.zernova.dev/mule-extension/current/zernova-extension.xsd
                               https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
                               https://schemas.zernova.dev/heisenberg https://schemas.zernova.dev/heisenberg/current/zernova-heisenberg.xsd
                               https://schemas.zernova.dev/operation https://schemas.zernova.dev/operation/current/zernova-operation.xsd">
    <description name="Errors"/>

    <errors>
        <error type="CUSTOM" parent="ZERNOVA:ANY" />
        <error type="ONE" />
        <error type="OTHER" parent="ONE" />
    </errors>

    <operation:def name="raiseCustom">
        <operation:output>
            <operation:payload-type type="void"/>
        </operation:output>
        <operation:body>
            <operation:raise-error type="CUSTOM" />
        </operation:body>
    </operation:def>

    <operation:def name="raiseOther">
        <operation:output>
            <operation:payload-type type="void"/>
        </operation:output>
        <operation:body>
            <operation:raise-error type="OTHER" />
        </operation:body>
    </operation:def>

    <operation:def name="silencingOneAndRaisingOther">
        <operation:output>
            <operation:payload-type type="void"/>
        </operation:output>
        <operation:body>
            <core:try>
                <operation:raise-error type="ONE" />
                <core:error-handler>
                    <core:on-error-continue>
                        <operation:raise-error type="OTHER" />
                    </core:on-error-continue>
                </core:error-handler>
            </core:try>
        </operation:body>
    </operation:def>

    <operation:def name="heisenbergCureCancer">
        <operation:output>
            <operation:payload-type type="void"/>
        </operation:output>
        <operation:body>
            <heisenberg:cure-cancer />
        </operation:body>
    </operation:def>
</extension>
