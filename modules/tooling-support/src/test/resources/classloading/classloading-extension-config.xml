<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:classloading="https://schemas.zernova.dev/classloading"
      xmlns="https://schemas.zernova.dev/core"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
               https://schemas.zernova.dev/classloading https://schemas.zernova.dev/classloading/current/zernova-classloading.xsd">

    <classloading:config name="cached">
        <classloading:cached-connection/>
    </classloading:config>

    <classloading:config name="pooling">
        <classloading:pooling-connection/>
    </classloading:config>

    <classloading:config name="none">
        <classloading:none-connection/>
    </classloading:config>

    <flow name="cached-operation">
        <classloading:some-operation config-ref="cached"/>
    </flow>

    <flow name="pooling-operation">
        <classloading:some-operation config-ref="pooling"/>
    </flow>

    <flow name="none-operation">
        <classloading:some-operation config-ref="none"/>
    </flow>

</zernova>
