<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:vegan="https://schemas.zernova.dev/vegan"
      xmlns="https://schemas.zernova.dev/core"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
               https://schemas.zernova.dev/vegan https://schemas.zernova.dev/vegan/current/zernova-vegan.xsd">


    <vegan:apple-config name="apple">
        <vegan:cook-book>
            <vegan:vegan-cook-book/>
        </vegan:cook-book>
    </vegan:apple-config>
    <vegan:banana-config name="banana"/>
    <vegan:kiwi-config name="kiwi"/>
    <vegan:peach-config name="peach">
        <vegan:connection/>
    </vegan:peach-config>

    <flow name="appleOk">
        <vegan:eat-apple config-ref="apple"/>
    </flow>

    <flow name="bananaOk">
        <vegan:eat-banana config-ref="banana"/>
    </flow>

    <flow name="kiwiOk">
        <vegan:eat-kiwi config-ref="kiwi"/>
    </flow>

    <flow name="peachOk">
        <vegan:harvest-peaches config-ref="peach"/>
        <logger/>
    </flow>

    <flow name="appleSourceOk">
        <vegan:harvest-apples config-ref="apple"/>
        <logger/>
    </flow>

    <flow name="eatComplexListOfMaps">
        <vegan:try-to-eat-this-list-of-maps>
            <vegan:foods>
                #[payload]
            </vegan:foods>
        </vegan:try-to-eat-this-list-of-maps>
    </flow>

</zernova>
