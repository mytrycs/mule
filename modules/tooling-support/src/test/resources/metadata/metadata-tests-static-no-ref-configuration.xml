<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:metadata="https://schemas.zernova.dev/metadata"
      xmlns="https://schemas.zernova.dev/core"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
               https://schemas.zernova.dev/metadata https://schemas.zernova.dev/metadata/current/zernova-metadata.xsd">

    <metadata:config name="config" data="hello" dataWithDefault="staticOverride">
        <metadata:connection/>
    </metadata:config>

    <flow name="resolverWithImplicitStaticConfig">
        <metadata:simple-multi-level-key-resolver config-ref="config" continent="AMERICA" country="USA" city="SFO"/>
    </flow>
</zernova>