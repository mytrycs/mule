<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:custom-os="https://schemas.zernova.dev/custom-os"
      xmlns:os="https://schemas.zernova.dev/os"
      xmlns="https://schemas.zernova.dev/core"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
            https://schemas.zernova.dev/custom-os https://schemas.zernova.dev/custom-os/current/zernova-custom-os.xsd
            https://schemas.zernova.dev/os https://schemas.zernova.dev/os/current/zernova-os.xsd">

    <os:config name="ObjectStore_Config">
        <custom-os:connection />
    </os:config>

    <os:object-store name="customOS" config-ref="ObjectStore_Config" />

    <flow name="customStore">
        <os:store key="key" objectStore="customOS">
            <os:value>Extend all the things!</os:value>
        </os:store>
        <custom-os:retrieve key="key" />
    </flow>

</zernova>
