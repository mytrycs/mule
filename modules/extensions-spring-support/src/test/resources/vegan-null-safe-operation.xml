<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:vegan="https://schemas.zernova.dev/vegan"
      xmlns="https://schemas.zernova.dev/core"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
               https://schemas.zernova.dev/vegan https://schemas.zernova.dev/vegan/current/zernova-vegan.xsd">


    <vegan:banana-config name="banana"/>
    <vegan:apple-config name="apple">
        <vegan:cook-book>
            <vegan:vegan-cook-book/>
        </vegan:cook-book>
    </vegan:apple-config>

    <vegan:healthy-food name="topLevelFood"/>

    <flow name="policy">
        <vegan:apply-policy/>
    </flow>

    <flow name="implementingType">
        <vegan:get-production/>
    </flow>

    <flow name="inConfig">
        <vegan:get-config />
    </flow>

    <flow name="topLevelNullSafe">
        <vegan:get-healthy-food healthyFood="topLevelFood"/>
    </flow>

    <flow name="nullSafeOnMap">
        <vegan:add-vegan-products-descriptions/>
    </flow>

    <flow name="nullSafeOnList">
        <vegan:register-vegan-products/>
    </flow>

    <flow name="nullSafeOnGroupAndPojo">
        <vegan:consuming-grouped-food/>
    </flow>

    <flow name="nullSafeOnSourceGroupAndPojo" initialState="stopped">
        <vegan:harvest-apples config-ref="apple"/>
        <logger/>
    </flow>

</zernova>
