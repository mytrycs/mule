<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:heisenberg="https://schemas.zernova.dev/heisenberg"
      xmlns="https://schemas.zernova.dev/core"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
               https://schemas.zernova.dev/heisenberg https://schemas.zernova.dev/heisenberg/current/zernova-heisenberg.xsd">

    <heisenberg:config name="heisenberg"
                       myName="#[vars.myName]"
                       age="50"
                       cancer="true"
                       dateOfBirth="1959-09-07T00:00:00"
                       dateOfDeath="2011-09-07T00:00:00-05:00"
                       money="100000"
                       initialHealth="CANCER"
                       finalHealth="CANCER" >
        <heisenberg:enemies>
            <heisenberg:enemy value="Gustavo Fring"/>
            <heisenberg:enemy value="Hank"/>
        </heisenberg:enemies>
        <heisenberg:monthly-incomes>
            <heisenberg:monthly-income value="12000"/>
            <heisenberg:monthly-income value="500"/>
        </heisenberg:monthly-incomes>
        <heisenberg:known-addresses>
            <heisenberg:known-address value="one address"/>
        </heisenberg:known-addresses>
    </heisenberg:config>

    <heisenberg:config name="staticHeisenberg"
                       myName="heisenberg"
                       age="50"
                       cancer="true"
                       dateOfBirth="1959-09-07T00:00:00"
                       dateOfDeath="2011-09-07T00:00:00-05:00"
                       money="100000"
                       initialHealth="CANCER"
                       finalHealth="CANCER" >
        <heisenberg:enemies>
            <heisenberg:enemy value="Gustavo Fring"/>
            <heisenberg:enemy value="Hank"/>
        </heisenberg:enemies>
        <heisenberg:monthly-incomes>
            <heisenberg:monthly-income value="12000"/>
            <heisenberg:monthly-income value="500"/>
        </heisenberg:monthly-incomes>
        <heisenberg:known-addresses>
            <heisenberg:known-address value="one address"/>
        </heisenberg:known-addresses>
    </heisenberg:config>

    <flow name="laundry">
        <heisenberg:launder config-ref="heisenberg" amount="#[payload]" />
    </flow>

    <flow name="staticLaundry">
        <heisenberg:launder config-ref="staticHeisenberg" amount="#[payload]" />
    </flow>

</zernova>
