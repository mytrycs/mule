<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:petstore="https://schemas.zernova.dev/petstore"
      xmlns:test="https://schemas.zernova.dev/test"
      xmlns="https://schemas.zernova.dev/core"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
                https://schemas.zernova.dev/test https://schemas.zernova.dev/test/current/zernova-test.xsd
               https://schemas.zernova.dev/petstore https://schemas.zernova.dev/petstore/current/zernova-petstore.xsd">

    <flow name="noLimit" initialState="stopped">
        <petstore:pet-adoption-limiting-source>
            <scheduling-strategy>
                <fixed-frequency frequency="100"/>
            </scheduling-strategy>
            <petstore:pets>
                <petstore:pet value="Pet1" />
                <petstore:pet value="Pet2" />
                <petstore:pet value="Pet3" />
                <petstore:pet value="Pet4" />
                <petstore:pet value="Pet5" />
                <petstore:pet value="Pet6" />
                <petstore:pet value="Pet7" />
            </petstore:pets>
            <petstore:watermarks>
                <petstore:watermark value="10" />
                <petstore:watermark value="10" />
                <petstore:watermark value="10" />
                <petstore:watermark value="10" />
                <petstore:watermark value="10" />
                <petstore:watermark value="10" />
                <petstore:watermark value="10" />
            </petstore:watermarks>
        </petstore:pet-adoption-limiting-source>
        <flow-ref name="adopt"/>
    </flow>

    <flow name="limitOne" initialState="stopped">
        <petstore:pet-adoption-limiting-source maxItemsPerPoll="1">
            <scheduling-strategy>
                <fixed-frequency frequency="100"/>
            </scheduling-strategy>
            <petstore:pets>
                <petstore:pet value="Pet1" />
                <petstore:pet value="Pet2" />
                <petstore:pet value="Pet3" />
                <petstore:pet value="Pet4" />
                <petstore:pet value="Pet5" />
                <petstore:pet value="Pet6" />
                <petstore:pet value="Pet7" />
            </petstore:pets>
            <petstore:watermarks>
                <petstore:watermark value="10" />
                <petstore:watermark value="10" />
                <petstore:watermark value="10" />
                <petstore:watermark value="10" />
                <petstore:watermark value="10" />
                <petstore:watermark value="10" />
                <petstore:watermark value="10" />
            </petstore:watermarks>
        </petstore:pet-adoption-limiting-source>
        <flow-ref name="adopt"/>
    </flow>

    <flow name="limitThree" initialState="stopped">
        <petstore:pet-adoption-limiting-source maxItemsPerPoll="3">
            <scheduling-strategy>
                <fixed-frequency frequency="100"/>
            </scheduling-strategy>
            <petstore:pets>
                <petstore:pet value="Pet1" />
                <petstore:pet value="Pet2" />
                <petstore:pet value="Pet3" />
                <petstore:pet value="Pet4" />
                <petstore:pet value="Pet5" />
                <petstore:pet value="Pet6" />
                <petstore:pet value="Pet7" />
            </petstore:pets>
            <petstore:watermarks>
                <petstore:watermark value="10" />
                <petstore:watermark value="10" />
                <petstore:watermark value="10" />
                <petstore:watermark value="10" />
                <petstore:watermark value="10" />
                <petstore:watermark value="10" />
                <petstore:watermark value="10" />
            </petstore:watermarks>
        </petstore:pet-adoption-limiting-source>
        <flow-ref name="adopt"/>
    </flow>

    <flow name="ascendingWatermark" initialState="stopped">
        <petstore:pet-adoption-limiting-source maxItemsPerPoll="1">
            <scheduling-strategy>
                <fixed-frequency frequency="100"/>
            </scheduling-strategy>
            <petstore:pets>
                <petstore:pet value="Pet1" />
                <petstore:pet value="Pet2" />
                <petstore:pet value="Pet3" />
                <petstore:pet value="Pet4" />
                <petstore:pet value="Pet5" />
                <petstore:pet value="Pet6" />
                <petstore:pet value="Pet7" />
            </petstore:pets>
            <petstore:watermarks>
                <petstore:watermark value="10" />
                <petstore:watermark value="11" />
                <petstore:watermark value="12" />
                <petstore:watermark value="13" />
                <petstore:watermark value="14" />
                <petstore:watermark value="15" />
                <petstore:watermark value="16" />
            </petstore:watermarks>
        </petstore:pet-adoption-limiting-source>
        <flow-ref name="adopt"/>
    </flow>

    <flow name="descendingWatermark" initialState="stopped">
        <petstore:pet-adoption-limiting-source maxItemsPerPoll="1">
            <scheduling-strategy>
                <fixed-frequency frequency="100"/>
            </scheduling-strategy>
            <petstore:pets>
                <petstore:pet value="Pet1" />
                <petstore:pet value="Pet2" />
                <petstore:pet value="Pet3" />
                <petstore:pet value="Pet4" />
                <petstore:pet value="Pet5" />
                <petstore:pet value="Pet6" />
                <petstore:pet value="Pet7" />
            </petstore:pets>
            <petstore:watermarks>
                <petstore:watermark value="10" />
                <petstore:watermark value="9" />
                <petstore:watermark value="8" />
                <petstore:watermark value="7" />
                <petstore:watermark value="6" />
                <petstore:watermark value="5" />
                <petstore:watermark value="4" />
            </petstore:watermarks>
        </petstore:pet-adoption-limiting-source>
        <flow-ref name="adopt"/>
    </flow>

    <flow name="mixedWatermark" initialState="stopped">
        <petstore:pet-adoption-limiting-source maxItemsPerPoll="1">
            <scheduling-strategy>
                <fixed-frequency frequency="100"/>
            </scheduling-strategy>
            <petstore:pets>
                <petstore:pet value="Pet1" />
                <petstore:pet value="Pet2" />
                <petstore:pet value="Pet3" />
                <petstore:pet value="Pet4" />
                <petstore:pet value="Pet5" />
                <petstore:pet value="Pet6" />
                <petstore:pet value="Pet7" />
            </petstore:pets>
            <petstore:watermarks>
                <petstore:watermark value="5" />
                <petstore:watermark value="6" />
                <petstore:watermark value="3" />
                <petstore:watermark value="2" />
                <petstore:watermark value="6" />
                <petstore:watermark value="5" />
                <petstore:watermark value="4" />
            </petstore:watermarks>
        </petstore:pet-adoption-limiting-source>
        <flow-ref name="adopt"/>
    </flow>

    <flow name="adopt">
        <test:processor class="com.zernova.test.module.extension.source.PollingSourceLimitingTestCase$AdoptionProcessor"/>
    </flow>
</zernova>