<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:petstore="https://schemas.zernova.dev/petstore"
      xmlns:test="https://schemas.zernova.dev/test"
      xmlns="https://schemas.zernova.dev/core"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
       https://schemas.zernova.dev/test https://schemas.zernova.dev/test/current/zernova-test.xsd
               https://schemas.zernova.dev/petstore https://schemas.zernova.dev/petstore/current/zernova-petstore.xsd">

    <petstore:config name="pooled-config" cashierName="Lola">
        <petstore:pooled-connection username="john" password="doe"/>
        <petstore:pets>
            <petstore:pet value="turtle"/>
        </petstore:pets>
    </petstore:config>

    <flow name="watermarkWithPooledConnection" initialState="stopped">
        <petstore:connected-pet-adoption-source config-ref="pooled-config" watermark="true" idempotent="true">
            <scheduling-strategy>
                <fixed-frequency frequency="500"/>
            </scheduling-strategy>
        </petstore:connected-pet-adoption-source>
        <test:processor/>
    </flow>

</zernova>
