<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:petstore="https://schemas.zernova.dev/petstore"
      xmlns="https://schemas.zernova.dev/core"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
               https://schemas.zernova.dev/petstore https://schemas.zernova.dev/petstore/current/zernova-petstore.xsd">


    <object name="event" class="com.zernova.test.module.extension.source.SourceExecutionSdkApiTestCase$SourceProcessor"/>

    <flow name="onSuccessMethodCallFlow" initialState="stopped">
        <petstore:pet-source-with-sdk-api/>
        <flow-ref name="event"/>
    </flow>

    <flow name="onErrorMethodCallFlow" initialState="stopped">
        <petstore:pet-source-with-sdk-api/>
        <flow-ref name="event"/>
        <raise-error type="APP:EXPECTED"/>
    </flow>
</zernova>
