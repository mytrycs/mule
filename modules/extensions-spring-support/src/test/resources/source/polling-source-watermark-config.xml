<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:petstore="https://schemas.zernova.dev/petstore"
      xmlns:test="https://schemas.zernova.dev/test"
      xmlns="https://schemas.zernova.dev/core"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
                https://schemas.zernova.dev/test https://schemas.zernova.dev/test/current/zernova-test.xsd
               https://schemas.zernova.dev/petstore https://schemas.zernova.dev/petstore/current/zernova-petstore.xsd">

    <object name="adopt" class="com.zernova.test.module.extension.source.PollingSourceWatermarkTestCase$AdoptionProcessor"/>

    <flow name="watermark" initialState="stopped">
        <petstore:pet-adoption-source watermark="true" idempotent="true">
            <scheduling-strategy>
                <fixed-frequency frequency="100"/>
            </scheduling-strategy>
        </petstore:pet-adoption-source>
        <flow-ref name="adopt"/>
    </flow>

    <flow name="repeatedItemInNewPollSetsUpdatedWatermark" initialState="stopped">
        <petstore:watermarking-pet-adoption-source itemsPerPoll="1">
            <scheduling-strategy>
                <fixed-frequency frequency="100"/>
            </scheduling-strategy>
            <petstore:pets>
                <petstore:pet value="Anibal" />
                <petstore:pet value="ANIBAL" />
                <petstore:pet value="Barbara" />
            </petstore:pets>
            <petstore:watermarks>
                <petstore:watermark value="5" />
                <petstore:watermark value="10" />
                <petstore:watermark value="7" />
            </petstore:watermarks>
        </petstore:watermarking-pet-adoption-source>
        <flow-ref name="adopt"/>
    </flow>

    <flow name="repeatedItemInNewPollDoesNotSetUpdatedWatermark" initialState="stopped">
        <petstore:watermarking-pet-adoption-source itemsPerPoll="2">
            <scheduling-strategy>
                <fixed-frequency frequency="100"/>
            </scheduling-strategy>
            <petstore:pets>
                <petstore:pet value="Anibal" />
                <petstore:pet value="Barbara" />
                <petstore:pet value="Colonel Meow" />
                <petstore:pet value="BARBARA" />
                <petstore:pet value="Daphne" />
            </petstore:pets>
            <petstore:watermarks>
                <petstore:watermark value="4" />
                <petstore:watermark value="5" />
                <petstore:watermark value="10" />
                <petstore:watermark value="7" />
                <petstore:watermark value="8" />
            </petstore:watermarks>
        </petstore:watermarking-pet-adoption-source>
        <flow-ref name="adopt"/>
    </flow>

</zernova>
