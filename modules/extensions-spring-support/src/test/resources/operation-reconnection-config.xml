<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:marvel="https://schemas.zernova.dev/marvel"
      xmlns:test="https://schemas.zernova.dev/test"
      xmlns="https://schemas.zernova.dev/core"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
      https://schemas.zernova.dev/test https://schemas.zernova.dev/test/current/zernova-test.xsd
               https://schemas.zernova.dev/marvel https://schemas.zernova.dev/marvel/current/zernova-marvel.xsd">

    <marvel:iron-man-config name="ironMan">
        <marvel:odd-missile-connection />
    </marvel:iron-man-config>

    <flow name="operationReconnection">
        <marvel:fire-missile at="#[payload]" config-ref="ironMan">
            <reconnect count="3" frequency="200"/>
        </marvel:fire-missile>
    </flow>

    <flow name="defaultReconnection">
        <marvel:fire-missile at="#[payload]" config-ref="ironMan"/>
    </flow>

</zernova>
