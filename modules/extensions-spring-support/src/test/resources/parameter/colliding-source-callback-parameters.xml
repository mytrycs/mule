<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:heisenberg="https://schemas.zernova.dev/heisenberg"
	xmlns="https://schemas.zernova.dev/core"
	xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
               https://schemas.zernova.dev/heisenberg https://schemas.zernova.dev/heisenberg/current/zernova-heisenberg.xsd">

	<heisenberg:config name="heisenberg" money="1000000"
		finalHealth="CANCER">
		<heisenberg:enemies />
		<heisenberg:monthly-incomes />
		<heisenberg:known-addresses />
	</heisenberg:config>

	<flow name="sourceCallbackError" initialState="stopped">
		<heisenberg:listen-payments-all-optional config-ref="heisenberg">
			<heisenberg:success-info age="27">
				<heisenberg:known-addresses>
					<heisenberg:known-address value="success address" />
				</heisenberg:known-addresses>
			</heisenberg:success-info>

			<heisenberg:methylamine importer="Madrigal" />

			<!-- no error info, must use the defaults -->
		</heisenberg:listen-payments-all-optional>

		<raise-error type="APP:EXPECTED" />
	</flow>

</zernova>
