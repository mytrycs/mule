<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:zernova="https://schemas.zernova.dev/core" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="https://schemas.zernova.dev/map" attributeFormDefault="unqualified" elementFormDefault="qualified">
  <xs:import namespace="http://www.w3.org/XML/1998/namespace"></xs:import>
  <xs:import namespace="https://schemas.zernova.dev/core" schemaLocation="https://schemas.zernova.dev/core/current/zernova.xsd"></xs:import>
  <xs:element xmlns:zernova="https://schemas.zernova.dev/core" substitutionGroup="zernova:abstract-shared-extension" name="config">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="zernova:abstractExtensionType">
          <xs:annotation>
            <xs:documentation>Default configuration</xs:documentation>
          </xs:annotation>
          <xs:sequence minOccurs="0" maxOccurs="1">
            <xs:element minOccurs="0" maxOccurs="1" ref="zernova:expiration-policy"></xs:element>
            <xs:element minOccurs="0" maxOccurs="1" name="required-map-defaults">
              <xs:complexType>
                <xs:sequence>
                  <xs:element minOccurs="0" maxOccurs="unbounded" name="required-map-default">
                    <xs:complexType>
                      <xs:attribute type="zernova:expressionString" use="required" name="key"></xs:attribute>
                      <xs:attribute type="xs:string" use="required" name="value"></xs:attribute>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element minOccurs="0" maxOccurs="1" name="required-map-no-expressions">
              <xs:complexType>
                <xs:sequence>
                  <xs:element minOccurs="0" maxOccurs="unbounded" name="required-map-no-expression">
                    <xs:complexType>
                      <xs:attribute type="zernova:expressionString" use="required" name="key"></xs:attribute>
                      <xs:attribute type="xs:string" use="required" name="value"></xs:attribute>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element minOccurs="0" maxOccurs="1" name="required-map-expression-supporteds">
              <xs:complexType>
                <xs:sequence>
                  <xs:element minOccurs="0" maxOccurs="unbounded" name="required-map-expression-supported">
                    <xs:complexType>
                      <xs:attribute type="zernova:expressionString" use="required" name="key"></xs:attribute>
                      <xs:attribute type="xs:string" use="required" name="value"></xs:attribute>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element minOccurs="0" maxOccurs="1" name="optional-map-defaults">
              <xs:complexType>
                <xs:sequence>
                  <xs:element minOccurs="0" maxOccurs="unbounded" name="optional-map-default">
                    <xs:complexType>
                      <xs:attribute type="zernova:expressionString" use="required" name="key"></xs:attribute>
                      <xs:attribute type="xs:string" use="required" name="value"></xs:attribute>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element minOccurs="0" maxOccurs="1" name="optional-map-no-expressions">
              <xs:complexType>
                <xs:sequence>
                  <xs:element minOccurs="0" maxOccurs="unbounded" name="optional-map-no-expression">
                    <xs:complexType>
                      <xs:attribute type="zernova:expressionString" use="required" name="key"></xs:attribute>
                      <xs:attribute type="xs:string" use="required" name="value"></xs:attribute>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element minOccurs="0" maxOccurs="1" name="optional-map-expression-supporteds">
              <xs:complexType>
                <xs:sequence>
                  <xs:element minOccurs="0" maxOccurs="unbounded" name="optional-map-expression-supported">
                    <xs:complexType>
                      <xs:attribute type="zernova:expressionString" use="required" name="key"></xs:attribute>
                      <xs:attribute type="xs:string" use="required" name="value"></xs:attribute>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
          <xs:attribute type="zernova:expressionMap" use="optional" name="requiredMapDefaults"></xs:attribute>
          <xs:attribute type="zernova:substitutableName" use="optional" name="requiredMapNoExpressions"></xs:attribute>
          <xs:attribute type="zernova:expressionMap" use="required" name="requiredMapExpressionRequireds"></xs:attribute>
          <xs:attribute type="zernova:expressionMap" use="optional" name="requiredMapExpressionSupporteds"></xs:attribute>
          <xs:attribute type="zernova:expressionMap" use="optional" name="optionalMapDefaults"></xs:attribute>
          <xs:attribute type="zernova:substitutableName" use="optional" name="optionalMapNoExpressions"></xs:attribute>
          <xs:attribute type="zernova:expressionMap" use="optional" name="optionalMapExpressionRequireds"></xs:attribute>
          <xs:attribute type="zernova:expressionMap" use="optional" name="optionalMapExpressionSupporteds"></xs:attribute>
          <xs:attribute type="xs:string" use="required" name="name">
            <xs:annotation>
              <xs:documentation>The identifier of this element used to reference it in other components</xs:documentation>
            </xs:annotation>
          </xs:attribute>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
  <xs:element xmlns="https://schemas.zernova.dev/map" xmlns:zernova="https://schemas.zernova.dev/core" type="FooType" substitutionGroup="zernova:abstract-operator" name="foo"></xs:element>
  <xs:complexType name="FooType">
    <xs:complexContent>
      <xs:extension xmlns:zernova="https://schemas.zernova.dev/core" base="zernova:abstractOperatorType">
        <xs:sequence minOccurs="0" maxOccurs="1"></xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
</xs:schema>