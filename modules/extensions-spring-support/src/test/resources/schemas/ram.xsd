<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:zernova="https://schemas.zernova.dev/core" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="https://schemas.zernova.dev/ram" attributeFormDefault="unqualified" elementFormDefault="qualified">
  <xs:import namespace="http://www.w3.org/XML/1998/namespace"></xs:import>
  <xs:import namespace="https://schemas.zernova.dev/core" schemaLocation="https://schemas.zernova.dev/core/current/zernova.xsd"></xs:import>
  <xs:complexType name="com.zernova.runtime.extension.api.soap.MessageDispatcherProvider">
    <xs:complexContent>
      <xs:extension xmlns:zernova="https://schemas.zernova.dev/core" base="zernova:abstractExtensionType"></xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:element xmlns:zernova="https://schemas.zernova.dev/core" xmlns:ram="https://schemas.zernova.dev/ram" type="ram:com.zernova.runtime.extension.api.soap.MessageDispatcherProvider" substitutionGroup="zernova:abstract-shared-extension" abstract="true" name="global-abstract-message-dispatcher-provider"></xs:element>
  <xs:element xmlns:ram="https://schemas.zernova.dev/ram" type="ram:com.zernova.runtime.extension.api.soap.MessageDispatcherProvider" abstract="true" name="abstract-message-dispatcher-provider"></xs:element>
  <xs:complexType name="com.zernova.test.ram.MiniverseDispatcherProvider">
    <xs:complexContent>
      <xs:extension xmlns:ram="https://schemas.zernova.dev/ram" base="ram:com.zernova.runtime.extension.api.soap.MessageDispatcherProvider"></xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:element xmlns:ram="https://schemas.zernova.dev/ram" type="ram:com.zernova.test.ram.MiniverseDispatcherProvider" substitutionGroup="ram:abstract-message-dispatcher-provider" abstract="true" name="abstract-miniverse-dispatcher-provider"></xs:element>
  <xs:element xmlns:ram="https://schemas.zernova.dev/ram" substitutionGroup="ram:abstract-miniverse-dispatcher-provider" name="miniverse-dispatcher-provider">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="ram:com.zernova.test.ram.MiniverseDispatcherProvider"></xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="com.zernova.test.ram.DefaultPortalGunDispatcherProvider">
    <xs:complexContent>
      <xs:extension xmlns:ram="https://schemas.zernova.dev/ram" base="ram:com.zernova.runtime.extension.api.soap.MessageDispatcherProvider">
        <xs:attribute xmlns:zernova="https://schemas.zernova.dev/core" type="zernova:expressionString" use="required" name="responseMessage"></xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:element xmlns:ram="https://schemas.zernova.dev/ram" type="ram:com.zernova.test.ram.DefaultPortalGunDispatcherProvider" substitutionGroup="ram:abstract-message-dispatcher-provider" abstract="true" name="abstract-default-portal-gun-dispatcher-provider"></xs:element>
  <xs:element xmlns:ram="https://schemas.zernova.dev/ram" substitutionGroup="ram:abstract-default-portal-gun-dispatcher-provider" name="default-portal-gun-dispatcher-provider">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="ram:com.zernova.test.ram.DefaultPortalGunDispatcherProvider"></xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="com.zernova.test.ram.TestHttpMessageDispatcherProvider">
    <xs:complexContent>
      <xs:extension xmlns:ram="https://schemas.zernova.dev/ram" base="ram:com.zernova.runtime.extension.api.soap.MessageDispatcherProvider"></xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:element xmlns:ram="https://schemas.zernova.dev/ram" type="ram:com.zernova.test.ram.TestHttpMessageDispatcherProvider" substitutionGroup="ram:abstract-message-dispatcher-provider" abstract="true" name="abstract-test-http-message-dispatcher-provider"></xs:element>
  <xs:element xmlns:ram="https://schemas.zernova.dev/ram" substitutionGroup="ram:abstract-test-http-message-dispatcher-provider" name="test-http-message-dispatcher-provider">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="ram:com.zernova.test.ram.TestHttpMessageDispatcherProvider"></xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
  <xs:element xmlns:zernova="https://schemas.zernova.dev/core" substitutionGroup="zernova:abstract-shared-extension" name="config">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="zernova:abstractExtensionType">
          <xs:annotation>
            <xs:documentation>Default configuration</xs:documentation>
          </xs:annotation>
          <xs:sequence minOccurs="1" maxOccurs="1">
            <xs:element minOccurs="1" maxOccurs="1" ref="zernova:abstractConnectionProvider"></xs:element>
            <xs:element minOccurs="0" maxOccurs="1" ref="zernova:expiration-policy"></xs:element>
          </xs:sequence>
          <xs:attribute type="xs:string" use="required" name="name">
            <xs:annotation>
              <xs:documentation>The identifier of this element used to reference it in other components</xs:documentation>
            </xs:annotation>
          </xs:attribute>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
  <xs:element xmlns:zernova="https://schemas.zernova.dev/core" substitutionGroup="zernova:abstractConnectionProvider" name="rick-and-morty-connection">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="zernova:abstractConnectionProviderType">
          <xs:sequence minOccurs="0" maxOccurs="1">
            <xs:element minOccurs="0" maxOccurs="1" ref="zernova:reconnection"></xs:element>
            <xs:element minOccurs="0" maxOccurs="1" ref="zernova:pooling-profile"></xs:element>
            <xs:element minOccurs="0" maxOccurs="1" name="transport">
              <xs:complexType>
                <xs:choice minOccurs="1" maxOccurs="1">
                  <xs:element xmlns:ram="https://schemas.zernova.dev/ram" minOccurs="1" maxOccurs="1" ref="ram:abstract-message-dispatcher-provider"></xs:element>
                  <xs:element xmlns:ram="https://schemas.zernova.dev/ram" minOccurs="1" maxOccurs="1" ref="ram:global-abstract-message-dispatcher-provider"></xs:element>
                </xs:choice>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
          <xs:attribute type="zernova:expressionString" use="required" name="wsdlUrl"></xs:attribute>
          <xs:attribute type="zernova:expressionString" use="required" name="service"></xs:attribute>
          <xs:attribute type="zernova:expressionString" use="required" name="port"></xs:attribute>
          <xs:attribute type="xs:string" use="optional" name="transport"></xs:attribute>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
  <xs:element xmlns="https://schemas.zernova.dev/ram" xmlns:zernova="https://schemas.zernova.dev/core" type="InvokeType" substitutionGroup="zernova:abstract-operator" name="invoke">
    <xs:annotation>
      <xs:documentation>invokes Web Service operations</xs:documentation>
    </xs:annotation>
  </xs:element>
  <xs:complexType name="InvokeType">
    <xs:complexContent>
      <xs:extension xmlns:zernova="https://schemas.zernova.dev/core" base="zernova:abstractOperatorType">
        <xs:sequence minOccurs="0" maxOccurs="1">
          <xs:element minOccurs="0" maxOccurs="1" ref="zernova:abstract-reconnection-strategy"></xs:element>
          <xs:element minOccurs="0" maxOccurs="1" name="message">
            <xs:complexType>
              <xs:complexContent>
                <xs:extension base="zernova:abstractExtensionType">
                  <xs:sequence>
                    <xs:element type="xs:string" minOccurs="0" maxOccurs="1" name="body"></xs:element>
                    <xs:element type="xs:string" minOccurs="0" maxOccurs="1" name="headers"></xs:element>
                    <xs:element type="xs:string" minOccurs="0" maxOccurs="1" name="attachments"></xs:element>
                  </xs:sequence>
                </xs:extension>
              </xs:complexContent>
            </xs:complexType>
          </xs:element>
          <xs:element minOccurs="0" maxOccurs="1" name="transport-headers">
            <xs:complexType>
              <xs:sequence>
                <xs:element minOccurs="0" maxOccurs="unbounded" name="transport-header">
                  <xs:complexType>
                    <xs:attribute type="zernova:expressionString" use="required" name="key"></xs:attribute>
                    <xs:attribute type="zernova:expressionString" use="required" name="value"></xs:attribute>
                  </xs:complexType>
                </xs:element>
              </xs:sequence>
            </xs:complexType>
          </xs:element>
        </xs:sequence>
        <xs:attribute type="xs:string" use="required" name="config-ref">
          <xs:annotation>
            <xs:documentation>The name of the configuration to be used to execute this component</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute type="zernova:expressionString" use="required" name="service"></xs:attribute>
        <xs:attribute type="zernova:expressionString" use="required" name="operation"></xs:attribute>
        <xs:attribute type="zernova:expressionMap" use="optional" name="transportHeaders"></xs:attribute>
        <xs:attribute type="xs:string" use="optional" name="target">
          <xs:annotation>
            <xs:documentation>The name of a variable on which the operation's output will be placed</xs:documentation>
          </xs:annotation>
        </xs:attribute>
        <xs:attribute type="zernova:expressionString" use="optional" default="#[payload]" name="targetValue">
          <xs:annotation>
            <xs:documentation>An expression that will be evaluated against the operation's output and the outcome of that expression will be stored in the target variable</xs:documentation>
          </xs:annotation>
        </xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
</xs:schema>