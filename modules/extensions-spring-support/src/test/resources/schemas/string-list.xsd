<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:zernova="https://schemas.zernova.dev/core" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="https://schemas.zernova.dev/string-list" attributeFormDefault="unqualified" elementFormDefault="qualified">
  <xs:import namespace="http://www.w3.org/XML/1998/namespace"></xs:import>
  <xs:import namespace="https://schemas.zernova.dev/core" schemaLocation="https://schemas.zernova.dev/core/current/zernova.xsd"></xs:import>
  <xs:element xmlns:zernova="https://schemas.zernova.dev/core" substitutionGroup="zernova:abstract-shared-extension" name="config">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="zernova:abstractExtensionType">
          <xs:annotation>
            <xs:documentation>Default configuration</xs:documentation>
          </xs:annotation>
          <xs:sequence minOccurs="0" maxOccurs="1">
            <xs:element minOccurs="0" maxOccurs="1" ref="zernova:expiration-policy"></xs:element>
            <xs:element minOccurs="0" maxOccurs="1" name="required-list-defaults">
              <xs:complexType>
                <xs:sequence>
                  <xs:element minOccurs="0" maxOccurs="unbounded" name="required-list-default">
                    <xs:complexType>
                      <xs:attribute type="zernova:expressionString" use="required" name="value"></xs:attribute>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element minOccurs="0" maxOccurs="1" name="required-list-no-expressions">
              <xs:complexType>
                <xs:sequence>
                  <xs:element minOccurs="0" maxOccurs="unbounded" name="required-list-no-expression">
                    <xs:complexType>
                      <xs:attribute type="zernova:expressionString" use="required" name="value"></xs:attribute>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element minOccurs="0" maxOccurs="1" name="required-list-expression-supporteds">
              <xs:complexType>
                <xs:sequence>
                  <xs:element minOccurs="0" maxOccurs="unbounded" name="required-list-expression-supported">
                    <xs:complexType>
                      <xs:attribute type="zernova:expressionString" use="required" name="value"></xs:attribute>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element minOccurs="0" maxOccurs="1" name="optional-list-defaults">
              <xs:complexType>
                <xs:sequence>
                  <xs:element minOccurs="0" maxOccurs="unbounded" name="optional-list-default">
                    <xs:complexType>
                      <xs:attribute type="zernova:expressionString" use="required" name="value"></xs:attribute>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element minOccurs="0" maxOccurs="1" name="optional-list-no-expressions">
              <xs:complexType>
                <xs:sequence>
                  <xs:element minOccurs="0" maxOccurs="unbounded" name="optional-list-no-expression">
                    <xs:complexType>
                      <xs:attribute type="zernova:expressionString" use="required" name="value"></xs:attribute>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
            <xs:element minOccurs="0" maxOccurs="1" name="optional-list-expression-supporteds">
              <xs:complexType>
                <xs:sequence>
                  <xs:element minOccurs="0" maxOccurs="unbounded" name="optional-list-expression-supported">
                    <xs:complexType>
                      <xs:attribute type="zernova:expressionString" use="required" name="value"></xs:attribute>
                    </xs:complexType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
          <xs:attribute type="zernova:expressionList" use="optional" name="requiredListDefaults"></xs:attribute>
          <xs:attribute type="zernova:substitutableName" use="optional" name="requiredListNoExpressions"></xs:attribute>
          <xs:attribute type="zernova:expressionList" use="required" name="requiredListExpressionRequireds"></xs:attribute>
          <xs:attribute type="zernova:expressionList" use="optional" name="requiredListExpressionSupporteds"></xs:attribute>
          <xs:attribute type="zernova:expressionList" use="optional" name="optionalListDefaults"></xs:attribute>
          <xs:attribute type="zernova:substitutableName" use="optional" name="optionalListNoExpressions"></xs:attribute>
          <xs:attribute type="zernova:expressionList" use="optional" name="optionalListExpressionRequireds"></xs:attribute>
          <xs:attribute type="zernova:expressionList" use="optional" name="optionalListExpressionSupporteds"></xs:attribute>
          <xs:attribute type="xs:string" use="required" name="name">
            <xs:annotation>
              <xs:documentation>The identifier of this element used to reference it in other components</xs:documentation>
            </xs:annotation>
          </xs:attribute>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
  <xs:element xmlns="https://schemas.zernova.dev/string-list" xmlns:zernova="https://schemas.zernova.dev/core" type="FooType" substitutionGroup="zernova:abstract-operator" name="foo"></xs:element>
  <xs:complexType name="FooType">
    <xs:complexContent>
      <xs:extension xmlns:zernova="https://schemas.zernova.dev/core" base="zernova:abstractOperatorType">
        <xs:sequence minOccurs="0" maxOccurs="1"></xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
</xs:schema>