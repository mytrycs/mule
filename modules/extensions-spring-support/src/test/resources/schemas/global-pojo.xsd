<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:zernova="https://schemas.zernova.dev/core" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="https://schemas.zernova.dev/global-pojo" attributeFormDefault="unqualified" elementFormDefault="qualified">
  <xs:import namespace="http://www.w3.org/XML/1998/namespace"></xs:import>
  <xs:import namespace="https://schemas.zernova.dev/core" schemaLocation="https://schemas.zernova.dev/core/current/zernova.xsd"></xs:import>
  <xs:element xmlns:zernova="https://schemas.zernova.dev/core" substitutionGroup="zernova:abstract-shared-extension" name="config">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="zernova:abstractExtensionType">
          <xs:annotation>
            <xs:documentation>Default configuration</xs:documentation>
          </xs:annotation>
          <xs:sequence minOccurs="0" maxOccurs="1">
            <xs:element minOccurs="0" maxOccurs="1" ref="zernova:expiration-policy"></xs:element>
            <xs:element minOccurs="0" maxOccurs="1" name="required-extensible-pojo">
              <xs:complexType>
                <xs:choice minOccurs="1" maxOccurs="1">
                  <xs:element xmlns:global-pojo="https://schemas.zernova.dev/global-pojo" minOccurs="1" maxOccurs="1" ref="global-pojo:abstract-extensible-owner"></xs:element>
                  <xs:element xmlns:global-pojo="https://schemas.zernova.dev/global-pojo" minOccurs="1" maxOccurs="1" ref="global-pojo:global-abstract-extensible-owner"></xs:element>
                </xs:choice>
              </xs:complexType>
            </xs:element>
          </xs:sequence>
          <xs:attribute type="xs:string" use="required" name="requiredPojoExpressionRequired"></xs:attribute>
          <xs:attribute type="xs:string" use="optional" name="requiredExtensiblePojo"></xs:attribute>
          <xs:attribute type="xs:string" use="required" name="name">
            <xs:annotation>
              <xs:documentation>The identifier of this element used to reference it in other components</xs:documentation>
            </xs:annotation>
          </xs:attribute>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="com.zernova.test.module.extension.internal.util.extension.connectivity.basic.ExtensibleOwner">
    <xs:complexContent>
      <xs:extension xmlns:zernova="https://schemas.zernova.dev/core" base="zernova:abstractExtensionType">
        <xs:attribute type="zernova:expressionString" use="required" name="requiredFieldDefault"></xs:attribute>
        <xs:attribute type="zernova:expressionString" use="required" name="requiredFieldExpressionSupported"></xs:attribute>
        <xs:attribute type="zernova:expressionString" use="required" name="requiredFieldExpressionRequired"></xs:attribute>
        <xs:attribute type="xs:string" use="required" name="requiredFieldExpressionNotSupported"></xs:attribute>
        <xs:attribute type="zernova:expressionString" use="optional" name="optionalFieldDefault"></xs:attribute>
        <xs:attribute type="zernova:expressionString" use="optional" name="optionalFieldExpressionSupported"></xs:attribute>
        <xs:attribute type="zernova:expressionString" use="optional" name="optionalFieldExpressionRequired"></xs:attribute>
        <xs:attribute type="xs:string" use="optional" name="optionalFieldExpressionNotSupported"></xs:attribute>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
  <xs:element xmlns:zernova="https://schemas.zernova.dev/core" xmlns:global-pojo="https://schemas.zernova.dev/global-pojo" type="global-pojo:com.zernova.test.module.extension.internal.util.extension.connectivity.basic.ExtensibleOwner" substitutionGroup="zernova:abstract-shared-extension" abstract="true" name="global-abstract-extensible-owner"></xs:element>
  <xs:element xmlns:global-pojo="https://schemas.zernova.dev/global-pojo" type="global-pojo:com.zernova.test.module.extension.internal.util.extension.connectivity.basic.ExtensibleOwner" abstract="true" name="abstract-extensible-owner"></xs:element>
  <xs:element xmlns:global-pojo="https://schemas.zernova.dev/global-pojo" substitutionGroup="global-pojo:abstract-extensible-owner" name="extensible-owner">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="global-pojo:com.zernova.test.module.extension.internal.util.extension.connectivity.basic.ExtensibleOwner"></xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
  <xs:element xmlns="https://schemas.zernova.dev/global-pojo" xmlns:zernova="https://schemas.zernova.dev/core" type="FooType" substitutionGroup="zernova:abstract-operator" name="foo"></xs:element>
  <xs:complexType name="FooType">
    <xs:complexContent>
      <xs:extension xmlns:zernova="https://schemas.zernova.dev/core" base="zernova:abstractOperatorType">
        <xs:sequence minOccurs="0" maxOccurs="1"></xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
</xs:schema>