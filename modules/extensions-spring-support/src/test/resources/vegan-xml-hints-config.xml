<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:vegan="https://schemas.zernova.dev/vegan"
      xmlns="https://schemas.zernova.dev/core"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
               https://schemas.zernova.dev/vegan https://schemas.zernova.dev/vegan/current/zernova-vegan.xsd">

    <vegan:banana-config name="banana"/>

    <flow name="eatFromExpression">
        <vegan:try-eat food="#[payload]"/>
    </flow>

    <flow name="eatFixedMeat">
        <vegan:try-eat food="Nice, juicy and tasty meat" argument1="reasons"/>
    </flow>

    <flow name="eatMeatWithIdentityCrisis">
        <vegan:try-eat food="Nice, juicy and tasty meat" />
    </flow>

    <flow name="eatBlank">
        <vegan:try-eat food="" argument2="reasons"/>
    </flow>

    <flow name="eatPealedBanana">
        <vegan:eat-pealed attributeOnlyBanana="#[java!org::zernova::tck::testmodels::fruit::Banana::new()]" />
    </flow>

</zernova>
