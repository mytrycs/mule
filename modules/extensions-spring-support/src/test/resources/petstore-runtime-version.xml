<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:petstore="https://schemas.zernova.dev/petstore"
      xmlns:test="https://schemas.zernova.dev/test"
      xmlns="https://schemas.zernova.dev/core"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
               https://schemas.zernova.dev/test https://schemas.zernova.dev/test/current/zernova-test.xsd
               https://schemas.zernova.dev/petstore https://schemas.zernova.dev/petstore/current/zernova-petstore.xsd">

    <object name="testProcessor" class="com.zernova.test.module.extension.connector.PetStoreRuntimeVersionTestCase$TestProcessor"/>

    <petstore:config name="config" cashierName="jim" pets="#[[]]">
        <petstore:connection username="john" password="doe"/>
        <petstore:cage>
            <petstore:birds>
                <petstore:bird key="mockingjay" value="15"/>
                <petstore:bird key="mockingbird" value="10"/>
            </petstore:birds>
            <petstore:ammenities>
                <petstore:ammenity value="spinning wheel"/>
                <petstore:ammenity value="food can"/>
            </petstore:ammenities>
        </petstore:cage>
    </petstore:config>

    <flow name="configWithRuntimeVersion">
        <petstore:get-config config-ref="config"/>
    </flow>

    <flow name="sourceWithRuntimeVersion" initialState="stopped">
        <petstore:pet-source birds="Primate"/>
        <flow-ref name="testProcessor"/>
    </flow>

    <flow name="connectionProviderWithRuntimeVersion" initialState="stopped">
        <petstore:get-client config-ref="config"/>
        <flow-ref name="testProcessor"/>
    </flow>

    <flow name="operationClassWithRuntimeVersion" initialState="stopped">
        <petstore:get-mule-version/>
        <flow-ref name="testProcessor"/>
    </flow>
    
</zernova>
