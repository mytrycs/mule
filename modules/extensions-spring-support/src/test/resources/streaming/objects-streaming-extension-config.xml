<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:marvel="https://schemas.zernova.dev/marvel"
      xmlns:test="https://schemas.zernova.dev/test"
      xmlns="https://schemas.zernova.dev/core"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
      https://schemas.zernova.dev/test https://schemas.zernova.dev/test/current/zernova-test.xsd
               https://schemas.zernova.dev/marvel https://schemas.zernova.dev/marvel/current/zernova-marvel.xsd">

    <object name="assertPayloadIsStreamProvider" class="com.zernova.test.module.extension.streaming.ObjectStreamingExtensionTestCase$AssertPayloadIsStreamProvider"/>

    <object name="assertPayloadIsNotStreamProvider"  class="com.zernova.test.module.extension.streaming.ObjectStreamingExtensionTestCase$AssertPayloadIsNotStreamProvider"/>

    <marvel:dr-strange-config name="drStrange">
        <marvel:mystic-connection />
    </marvel:dr-strange-config>

    <flow name="getStream">
        <marvel:say-magic-words fetchSize="20" config-ref="drStrange" />
        <flow-ref name="assertPayloadIsStreamProvider"/>
        <marvel:read-object-stream/>
    </flow>

    <flow name="getStreamWithTarget">
        <marvel:say-magic-words fetchSize="20" config-ref="drStrange" target="myStreamVar"/>
    </flow>

    <flow name="getStreamWithTargetValue">
        <marvel:say-magic-words fetchSize="20" config-ref="drStrange" target="myStreamVar" targetValue="#[payload[0]]"/>
    </flow>

    <flow name="getStreamWithoutStreaming">
        <marvel:say-magic-words fetchSize="20" config-ref="drStrange">
            <non-repeatable-iterable/>
        </marvel:say-magic-words>

        <flow-ref name="assertPayloadIsNotStreamProvider"/>
    </flow>

    <flow name="getStreamInTx">
        <try transactionalAction="BEGIN_OR_JOIN">
            <flow-ref name="getStream"/>
        </try>
    </flow>

    <flow name="crashCar">
        <marvel:say-magic-words fetchSize="20" config-ref="drStrange" />
        <marvel:crash-car config-ref="drStrange" />
    </flow>

    <flow name="crashCarTx">
        <try transactionalAction="BEGIN_OR_JOIN">
            <marvel:say-magic-words fetchSize="20" config-ref="drStrange" />
            <marvel:crash-car config-ref="drStrange" />
        </try>
    </flow>

</zernova>
