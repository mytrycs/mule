<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:petstore="https://schemas.zernova.dev/petstore"
      xmlns="https://schemas.zernova.dev/core"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
               https://schemas.zernova.dev/petstore https://schemas.zernova.dev/petstore/current/zernova-petstore.xsd">

    <petstore:config name="defaultPoolingPoolable" cashierName="jim">
        <petstore:pooled-connection username="john" password="doe"/>
        <petstore:pets>
            <petstore:pet value="Lassie" />
            <petstore:pet value="Sapo Pepe" />
            <petstore:pet value="My mother's parrot" />
        </petstore:pets>
    </petstore:config>

    <petstore:config name="customPoolingPoolable" cashierName="jim">
        <petstore:pooled-connection username="john" password="doe">
            <pooling-profile maxActive="3" exhaustedAction="WHEN_EXHAUSTED_FAIL" />
        </petstore:pooled-connection>
        <petstore:pets>
            <petstore:pet value="Lassie" />
            <petstore:pet value="Sapo Pepe" />
            <petstore:pet value="My mother's parrot" />
        </petstore:pets>
    </petstore:config>

    <petstore:config name="noPooling" cashierName="jim">
        <petstore:pooled-connection username="john" password="doe">
            <pooling-profile disabled="true" />
        </petstore:pooled-connection>
        <petstore:pets>
            <petstore:pet value="Lassie" />
            <petstore:pet value="Sapo Pepe" />
            <petstore:pet value="My mother's parrot" />
        </petstore:pets>
    </petstore:config>

</zernova>