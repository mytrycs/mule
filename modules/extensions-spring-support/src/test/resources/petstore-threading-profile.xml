<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:petstore="https://schemas.zernova.dev/petstore"
      xmlns="https://schemas.zernova.dev/core"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
               https://schemas.zernova.dev/petstore https://schemas.zernova.dev/petstore/current/zernova-petstore.xsd">

    <petstore:config name="customThreadingProfile" cashierName="jim">
        <petstore:connection username="john" password="doe"/>
        <threading-profile maxThreadsActive="20" doThreading="false"/>
        <petstore:pets>
            <petstore:pet value="Lassie"/>
            <petstore:pet value="Sapo Pepe"/>
            <petstore:pet value="My mother's parrot"/>
        </petstore:pets>
    </petstore:config>

    <petstore:config name="noThreadingProfile" cashierName="jim">
        <petstore:connection username="john" password="doe"/>
        <petstore:pets>
            <petstore:pet value="Lassie"/>
            <petstore:pet value="Sapo Pepe"/>
            <petstore:pet value="My mother's parrot"/>
        </petstore:pets>
    </petstore:config>

    <petstore:config name="connectionThreadingProfile" cashierName="jim">
        <petstore:connection username="john" password="doe">
            <threading-profile maxThreadsActive="20" doThreading="false"/>
        </petstore:connection>
        <petstore:pets>
            <petstore:pet value="Lassie"/>
            <petstore:pet value="Sapo Pepe"/>
            <petstore:pet value="My mother's parrot"/>
        </petstore:pets>
    </petstore:config>

    <flow name="getClient">
        <petstore:get-client config-ref="connectionThreadingProfile"/>
    </flow>

</zernova>
