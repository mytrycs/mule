<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:petstore="https://schemas.zernova.dev/petstore"
      xmlns="https://schemas.zernova.dev/core"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
               https://schemas.zernova.dev/petstore https://schemas.zernova.dev/petstore/current/zernova-petstore.xsd">

    <petstore:config name="configWithChildElements" cashierName="jim" >
        <petstore:connection username="john" password="doe"/>
        <petstore:pets>
            <petstore:pet value="Dog"/>
        </petstore:pets>
    </petstore:config>

    <flow name="getForbiddenPetWithExpression">
        <set-variable variableName="petName" value="DOG"/>
        <petstore:get-forbidden-pets>
            <petstore:forbidden-pets>
                <petstore:forbidden-pet value="#[vars.petName]"/>
                <petstore:forbidden-pet value="CAT"/>
            </petstore:forbidden-pets>
        </petstore:get-forbidden-pets>
    </flow>
</zernova>
