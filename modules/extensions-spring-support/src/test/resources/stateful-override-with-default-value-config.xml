<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:implicitexclusive="https://schemas.zernova.dev/implicitexclusive"
      xmlns="https://schemas.zernova.dev/core"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
               https://schemas.zernova.dev/implicitexclusive https://schemas.zernova.dev/implicitexclusive/current/zernova-implicitexclusive.xsd">

    <implicitexclusive:bla-with-default-config name="with-assigned-value" optionalWithStaticDefault="Custom value in config!"/>

    <flow name="configValueOverriden">
        <implicitexclusive:get-string optionalWithStaticDefault="Custom value in operation!"/>
    </flow>

    <flow name="withConfigValueFromImplicitConfig">
        <implicitexclusive:get-string/>
    </flow>

    <flow name="customConfigValue">
        <implicitexclusive:get-string config-ref="with-assigned-value"/>
    </flow>

</zernova>
