<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:petstore="https://schemas.zernova.dev/petstore"
      xmlns="https://schemas.zernova.dev/core"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
               https://schemas.zernova.dev/petstore https://schemas.zernova.dev/petstore/current/zernova-petstore.xsd">

    <petstore:config name="petstore-config-reconnect" cashierName="jim">
        <petstore:connection username="john" password="doe">
            <reconnection>
                <reconnect count="1" frequency="0"/>
            </reconnection>
        </petstore:connection>
        <petstore:pets>
            <petstore:pet value="Dog"/>
        </petstore:pets>
    </petstore:config>

    <petstore:config name="petstore-config" cashierName="jim">
        <petstore:connection username="john" password="doe">
            <reconnection failsDeployment="true"/>
        </petstore:connection>
        <petstore:pets>
            <petstore:pet value="Dog"/>
        </petstore:pets>
    </petstore:config>

    <flow name="source-fail-on-start" initialState="stopped">
        <petstore:source failOnStart="true" config-ref="petstore-config">
            <reconnect count="1" frequency="0"/>
        </petstore:source>
        <set-payload value="#[payload]"/>
    </flow>

    <flow name="source-fail-with-connection-exception" initialState="stopped">
        <petstore:source failOnException="true" config-ref="petstore-config">
            <redelivery-policy maxRedeliveryCount="2"/>
            <reconnect count="1" frequency="0"/>
        </petstore:source>
        <set-payload value="#[payload]"/>
    </flow>

    <flow name="source-fail-on-start-fallback-to-connection" initialState="stopped">
        <petstore:source failOnStart="true" config-ref="petstore-config-reconnect"/>
        <set-payload value="#[payload]"/>
    </flow>

    <flow name="source-fail-with-connection-exception-fallback-to-connection" initialState="stopped">
        <petstore:source failOnException="true" config-ref="petstore-config-reconnect">
            <redelivery-policy maxRedeliveryCount="2"/>
        </petstore:source>
        <set-payload value="#[payload]"/>
    </flow>

</zernova>
