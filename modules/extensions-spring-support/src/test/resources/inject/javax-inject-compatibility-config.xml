<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:javax-inject="https://schemas.zernova.dev/javax-inject"
      xmlns="https://schemas.zernova.dev/core"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
               https://schemas.zernova.dev/javax-inject https://schemas.zernova.dev/javax-inject/current/zernova-javax-inject.xsd">

    <flow name="source" initialState="stopped">
         <javax-inject:source />
         <set-payload value="#[java!org::zernova::test::module::extension::inject::JavaxInjectCompatibilityTestCase::storeData(payload)]" />
    </flow>

    <flow name="sourceConfig" initialState="stopped">
         <javax-inject:source />
         <set-payload value="#[java!org::zernova::test::module::extension::inject::JavaxInjectCompatibilityTestCase::storeData(attributes)]" />
    </flow>

    <flow name="operation">
         <javax-inject:execute />
    </flow>

    <flow name="operationConfig">
         <javax-inject:execute-config />
    </flow>

    <flow name="operationConnection">
         <javax-inject:execute-connection />
    </flow>

    <flow name="operationPojo">
         <javax-inject:execute-pojo >
         	<javax-inject:pojo-param/>
         </javax-inject:execute-pojo>
    </flow>

    <flow name="valueProvider">
         <javax-inject:value-provider param="v"/>
    </flow>

    <flow name="function">
         <set-payload value="#[JavaxInject::execute()]" />
    </flow>

</zernova>
