<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:petstore="https://schemas.zernova.dev/petstore"
      xmlns:tls="https://schemas.zernova.dev/tls"
      xmlns="https://schemas.zernova.dev/core"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
      https://schemas.zernova.dev/tls https://schemas.zernova.dev/tls/current/zernova-tls.xsd
               https://schemas.zernova.dev/petstore https://schemas.zernova.dev/petstore/current/zernova-petstore.xsd">

    <tls:context name="globalTlsContext">
        <tls:trust-store path="ssltest-cacerts.jks" password="changeit"/>
        <tls:key-store path="ssltest-keystore.jks" keyPassword="changeit" password="changeit"/>
    </tls:context>

    <petstore:config name="globalTls" cashierName="jim">
        <petstore:connection username="john" password="doe" tlsContext="globalTlsContext"/>
        <petstore:pets>
            <petstore:pet value="Lassie" />
            <petstore:pet value="Sapo Pepe" />
            <petstore:pet value="My mother's parrot" />
        </petstore:pets>
    </petstore:config>

    <petstore:config name="inlineTls" cashierName="jim">
        <petstore:connection username="john" password="doe">
            <tls:context>
                <tls:trust-store path="ssltest-cacerts.jks" password="changeit"/>
                <tls:key-store path="ssltest-keystore.jks" keyPassword="changeit" password="changeit"/>
            </tls:context>
        </petstore:connection>
        <petstore:pets>
            <petstore:pet value="Lassie" />
            <petstore:pet value="Sapo Pepe" />
            <petstore:pet value="My mother's parrot" />
        </petstore:pets>
    </petstore:config>

    <flow name="getClient">
        <petstore:get-client config-ref="${config}" />
    </flow>
</zernova>