<?xml version="1.0" encoding="UTF-8"?>
<module name="module-w"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="https://schemas.zernova.dev/module"
        xmlns:zernova="https://schemas.zernova.dev/core"
        xmlns:tns="https://schemas.zernova.dev/module-w"
        xsi:schemaLocation="
           https://schemas.zernova.dev/module https://schemas.zernova.dev/module/current/zernova-module.xsd
           https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
           https://schemas.zernova.dev/module-w https://schemas.zernova.dev/module-w/current/zernova-module-w.xsd">
    <operation name="op1">
        <body>
            <tns:internal-op/>
            <zernova:set-payload value="#['w-op1 ' ++ payload]"/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="internal-op" visibility="PRIVATE">
        <body>
            <zernova:set-payload value="w-internal-op"/>
        </body>
        <output type="string"/>
    </operation>
</module>
