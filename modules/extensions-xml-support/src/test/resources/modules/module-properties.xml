<?xml version="1.0" encoding="UTF-8"?>
<module name="module-properties"
        xmlns="https://schemas.zernova.dev/module"
        xmlns:zernova="https://schemas.zernova.dev/core"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:tns="https://schemas.zernova.dev/module-properties"
        xsi:schemaLocation="
           https://schemas.zernova.dev/module https://schemas.zernova.dev/module/current/zernova-module.xsd
           https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
           https://schemas.zernova.dev/module-properties https://schemas.zernova.dev/module-properties/current/zernova-module-properties.xsd">

    <zernova:global-property name="mule-global-property" value="a-constant-global-value" />

    <property name="configParam" type="string"/>
    <property name="defaultConfigParam" defaultValue="some default-config-value-parameter" type="string"/>
    <property name="optionalProperty" use="OPTIONAL" type="string"/>
    <property name="defaultConfigPropertyUseOptional" use="OPTIONAL" defaultValue="some default-config-value-parameter" type="string"/>

    <operation name="set-payload-hardcoded-value">
        <body>
            <zernova:set-payload value="hardcoded value from module"/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="set-payload-param-value">
        <parameters>
            <parameter name="value" type="string"/>
        </parameters>
        <body>
            <zernova:set-payload value="#[vars.value ++ ' from module']"/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="set-payload-config-param-value">
        <body>
            <zernova:set-payload value="#[vars.configParam]"/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="set-payload-config-default-param-value">
        <body>
            <zernova:set-payload value="#[vars.defaultConfigParam]"/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="set-payload-config-default-property-use-optional">
        <body>
            <zernova:set-payload value="#[vars.defaultConfigPropertyUseOptional]"/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="set-payload-add-param-and-property-values">
        <parameters>
            <parameter name="value1" type="string"/>
        </parameters>
        <body>
            <zernova:set-payload value="#[vars.value1 ++ ' ' ++ vars.configParam]"/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="set-payload-config-optional-property">
        <body>
            <zernova:set-payload value="a value"/>
            <!-- will override payload with the null 'optionalProperty' parameter-->
            <zernova:set-payload value="#[vars.optionalProperty]"/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="set-payload-hardcoded-global-property">
        <body>
            <zernova:set-payload value="${mule-global-property}"/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="set-payload-hardcoded-system-property">
        <body>
            <zernova:set-payload value="${user.home}"/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="set-payload-hardcoded-file-property">
        <body>
            <!-- notice we need to add the folder modules to be sure it will be loaded in the context of the running test -->
            <zernova:set-payload value="${file::modules/module-properties-file.txt}"/>
        </body>
        <output type="string"/>
    </operation>
    
    <operation name="set-payload-add-param-and-property-values-thru-internal-operation">
        <parameters>
            <parameter name="inputParam" type="string"/>
        </parameters>
        <body>
            <tns:set-payload-add-param-and-property-values value1="#[vars.inputParam]"/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="call-private-nested-operations">
        <parameters>
            <parameter name="inputParam" type="string"/>
        </parameters>
        <body>
          <tns:call-another-private-nested-operation nested_inputParam="#[vars.inputParam ++ ' These are two']"/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="call-another-private-nested-operation" visibility="PRIVATE">
        <parameters>
            <parameter name="nested_inputParam" type="string"/>
        </parameters>
        <body>
            <tns:set-payload-with-all-properties deeper_nested_inputParam="#[vars.nested_inputParam ++ ' nice properties, ' ++ vars.defaultConfigPropertyUseOptional]"/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="set-payload-with-all-properties" visibility="PRIVATE">
        <parameters>
            <parameter name="deeper_nested_inputParam" type="string"/>
        </parameters>
        <body>
          <zernova:set-payload value="#[vars.deeper_nested_inputParam ++  ' and ' ++ vars.defaultConfigParam]"/>
        </body>
        <output type="string"/>
    </operation>

</module>
