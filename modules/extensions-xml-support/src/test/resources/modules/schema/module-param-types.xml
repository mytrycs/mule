<?xml version="1.0" encoding="UTF-8"?>
<module name="module-param-types"
        xmlns="https://schemas.zernova.dev/module"
        xmlns:zernova="https://schemas.zernova.dev/core"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           https://schemas.zernova.dev/module https://schemas.zernova.dev/module/current/zernova-module.xsd
           https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd">

    <operation name="integer-param-operation">
        <parameters>
            <parameter name="integerParam" type="number"/>
        </parameters>
        <body>
            <zernova:set-payload value="some value"/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="boolean-param-operation">
        <parameters>
            <parameter name="booleanParam" type="boolean"/>
        </parameters>
        <body>
            <zernova:set-payload value="some value"/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="date-param-operation">
        <parameters>
            <parameter name="dateParam" type="date"/>
        </parameters>
        <body>
            <zernova:set-payload value="some value"/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="datetime-param-operation">
        <parameters>
            <parameter name="datetimeParam" type="datetime"/>
        </parameters>
        <body>
            <zernova:set-payload value="some value"/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="string-param-operation">
        <parameters>
            <parameter name="stringParam" type="string"/>
        </parameters>
        <body>
            <zernova:set-payload value="some value"/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="time-param-operation">
        <parameters>
            <parameter name="timeParam" type="time"/>
        </parameters>
        <body>
            <zernova:set-payload value="some value"/>
        </body>
        <output type="string"/>
    </operation>
</module>
