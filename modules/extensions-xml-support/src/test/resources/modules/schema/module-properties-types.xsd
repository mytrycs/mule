<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:zernova="https://schemas.zernova.dev/core" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="https://schemas.zernova.dev/module-properties-types" attributeFormDefault="unqualified" elementFormDefault="qualified">
  <xs:import namespace="http://www.w3.org/XML/1998/namespace"></xs:import>
  <xs:import namespace="https://schemas.zernova.dev/core" schemaLocation="https://schemas.zernova.dev/core/current/zernova.xsd"></xs:import>
  <xs:element xmlns:zernova="https://schemas.zernova.dev/core" substitutionGroup="zernova:abstract-shared-extension" name="config">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="zernova:abstractExtensionType">
          <xs:sequence minOccurs="0" maxOccurs="1">
            <xs:element minOccurs="0" maxOccurs="1" ref="zernova:expiration-policy"></xs:element>
          </xs:sequence>
          <xs:attribute type="zernova:expressionDecimal" use="required" name="integerParam"></xs:attribute>
          <xs:attribute type="zernova:expressionBoolean" use="required" name="booleanParam"></xs:attribute>
          <xs:attribute type="zernova:expressionDateTime" use="required" name="dateParam"></xs:attribute>
          <xs:attribute type="zernova:expressionDateTime" use="required" name="datetimeParam"></xs:attribute>
          <xs:attribute type="zernova:expressionString" use="required" name="stringParam"></xs:attribute>
          <xs:attribute type="xs:string" use="required" name="timeParam"></xs:attribute>
          <xs:attribute type="zernova:expressionString" use="optional" name="optionalProperty"></xs:attribute>
          <xs:attribute type="xs:string" use="required" name="name">
            <xs:annotation>
              <xs:documentation>The identifier of this element used to reference it in other components</xs:documentation>
            </xs:annotation>
          </xs:attribute>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>
</xs:schema>
