<?xml version="1.0" encoding="UTF-8"?>
<module name="module-content"
        xmlns="https://schemas.zernova.dev/module"
        xmlns:zernova="https://schemas.zernova.dev/core"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           https://schemas.zernova.dev/module https://schemas.zernova.dev/module/current/zernova-module.xsd
           https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd">

    <operation name="set-payload-using-content-parameter">
        <parameters>
            <parameter name="content" type="string" role="CONTENT"/>
        </parameters>
        <body>
            <zernova:set-payload value="#[vars.content]"/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="set-payload-using-optional-content-parameter">
        <parameters>
            <parameter name="content" type="string" use="OPTIONAL" role="CONTENT"/>
        </parameters>
        <body>
            <zernova:set-payload value="#[vars.content default 'param was null']"/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="set-payload-using-content-and-simple-parameter">
        <parameters>
            <parameter name="parameter1" type="string"/>
            <parameter name="content" type="string" role="CONTENT"/>
        </parameters>
        <body>
            <zernova:set-payload value="#['attribute value:[' ++ vars.parameter1 ++ '], value of content (accessing map under key smart):[' ++ vars.content ++ ']']"/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="set-payload-using-primary-parameter">
        <parameters>
            <parameter name="primary" type="string" role="PRIMARY"/>
        </parameters>
        <body>
            <zernova:set-payload value="#[vars.primary]"/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="set-payload-using-content-and-primary-and-simple-parameter">
        <parameters>
            <parameter name="parameter1" type="string"/>
            <parameter name="content" type="string" role="CONTENT"/>
            <parameter name="primary" type="string" role="PRIMARY"/>
        </parameters>
        <body>
            <zernova:set-payload value="#['attribute value:[' ++ vars.parameter1 ++ '], value of content:[' ++ vars.content ++ '], value of primary:[' ++ vars.primary ++ ']']"/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="set-payload-using-content-and-primary-camel-case-and-simple-parameter">
        <parameters>
            <parameter name="parameter1" type="string"/>
            <parameter name="contentCamelCase" type="string" role="CONTENT"/>
            <parameter name="primaryCamelCaseToo" type="string" role="PRIMARY"/>
        </parameters>
        <body>
            <zernova:set-payload value="#['attribute value:[' ++ vars.parameter1 ++ '], value of content:[' ++ vars.contentCamelCase ++ '], value of primary:[' ++ vars.primaryCamelCaseToo ++ ']']"/>
        </body>
        <output type="string"/>
    </operation>
</module>
