<?xml version="1.0" encoding="UTF-8"?>
<module name="Capitalized with spaces in the name"
        namespace="https://schemas.zernova.dev/capitalized"

        xmlns="https://schemas.zernova.dev/module"
        xmlns:zernova="https://schemas.zernova.dev/core"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           https://schemas.zernova.dev/module https://schemas.zernova.dev/module/current/zernova-module.xsd
           https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd">

    <property name="a-property" type="string"/>
    <property name="_theUnderscoreProperty" type="string"/>

    <operation name="set-payload-hardcoded-value">
        <body>
            <zernova:set-payload value="hardcoded value"/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="_underscore-set-payload-with-parameter">
        <parameters>
            <parameter name="_theUnderscore" type="string"/>
        </parameters>
        <body>
            <zernova:set-payload value="#[vars['_theUnderscoreProperty'] ++ ', ' ++ vars['_theUnderscore']]"/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="set-payload-with-name-parameter">
        <parameters>
            <parameter name="name" type="string"/>
        </parameters>
        <body>
            <zernova:set-payload value="#[vars.name]"/>
        </body>
        <output type="string"/>
    </operation>
</module>
