<?xml version="1.0" encoding="UTF-8"?>
<module name="module-xsd-custom-types"
        xmlns="https://schemas.zernova.dev/module"
        xmlns:zernova="https://schemas.zernova.dev/core"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           https://schemas.zernova.dev/module https://schemas.zernova.dev/module/current/zernova-module.xsd
           https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd">

    <operation name="operation-with-custom-types">
        <parameters>
            <parameter name="value" type="XsdType1::{http://validationnamespace.raml.org}User"/>
            <!--extra parameter without targetNamespace in the schema under XsdType3-->
            <parameter name="value2" type="XsdType3::Root"/>
        </parameters>
        <body>
            <zernova:set-payload value="#[vars.value]"/>
        </body>
        <output type="XsdType2::{http://uri}Root0"/>
    </operation>

    <operation name="is-xsdtype1">
        <parameters>
            <parameter name="aParameter" type="XsdType1::{http://validationnamespace.raml.org}User"/>
        </parameters>
        <body>
            <zernova:set-payload value="#[output application/java --- vars.aParameter is { User : { name: String, kind: String, weight : String, email : String, userId: String } }]"/>
        </body>
        <output type="boolean"/>
    </operation>

    <operation name="get-hardcoded-xsdtype1">
        <body>
            <zernova:set-payload value="#[ns val http://validationnamespace.raml.org --- { val#User: { val#name: 'somename', val#kind: 'somekind', val#weight: 100, val#email: 'somename@domain.com', val#userId: 'somename-id' } }]" />
        </body>
        <output type="XsdType1::{http://validationnamespace.raml.org}User"/>
    </operation>

    <operation name="copy-xsdtype1">
        <parameters>
            <parameter name="aParameter" type="XsdType1::{http://validationnamespace.raml.org}User"/>
        </parameters>
        <body>
            <zernova:set-payload value="#[output application/java
            ns val http://validationnamespace.raml.org --- { val#User: { val#name: vars.aParameter.User.name, val#kind: vars.aParameter.User.kind, val#weight: vars.aParameter.User.weight as Number, val#email: vars.aParameter.User.email, val#userId: vars.aParameter.User.userId } }]" />
        </body>
        <output type="XsdType1::{http://validationnamespace.raml.org}User"/>
    </operation>
</module>
