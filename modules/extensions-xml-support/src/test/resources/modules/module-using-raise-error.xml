<?xml version="1.0" encoding="UTF-8"?>
<module name="module-using-raise-error"
        xmlns="https://schemas.zernova.dev/module"
        xmlns:zernova="https://schemas.zernova.dev/core"
        xmlns:marvel="https://schemas.zernova.dev/marvel"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           https://schemas.zernova.dev/module https://schemas.zernova.dev/module/current/zernova-module.xsd
           https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
           https://schemas.zernova.dev/marvel https://schemas.zernova.dev/marvel/current/zernova-marvel.xsd">

    <operation name="fail-raise-error">
        <parameters>
            <parameter name="custom" type="boolean" defaultValue="false"/>
        </parameters>
        <body>
            <zernova:choice>
                <zernova:when expression="#[vars.custom]">
                    <zernova:raise-error type="MODULE-USING-RAISE-ERROR:SMART_CONNECTOR_CUSTOM" description="A custom error occurred."/>
                </zernova:when>
                <zernova:otherwise>
                    <zernova:raise-error type="CONNECTIVITY" description="#['A module error ' ++ 'occurred.']"/>
                </zernova:otherwise>
            </zernova:choice>
        </body>
        <output type="string"/>
        <errors>
            <error type="SMART_CONNECTOR_CUSTOM"/>
        </errors>
    </operation>

    <operation name="fail-custom-exception">
        <parameters>
            <parameter name="content" type="binary"/>
        </parameters>
        <body>
            <marvel:read-stream data="#[vars.content]"/>
        </body>
        <output type="string"/>
    </operation>

</module>
