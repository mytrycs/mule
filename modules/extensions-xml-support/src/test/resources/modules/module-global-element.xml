<?xml version="1.0" encoding="UTF-8"?>
<module name="module-global-element"
        xmlns="https://schemas.zernova.dev/module"
        xmlns:tns="https://schemas.zernova.dev/module-global-element"
        xmlns:petstore="https://schemas.zernova.dev/petstore"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           https://schemas.zernova.dev/module https://schemas.zernova.dev/module/current/zernova-module.xsd
           https://schemas.zernova.dev/module-global-element https://schemas.zernova.dev/module-global-element/current/zernova-module-global-element.xsd
           https://schemas.zernova.dev/petstore https://schemas.zernova.dev/petstore/current/zernova-petstore.xsd">

    <property name="username" type="string"/>
    <property name="password" type="string"/>

    <petstore:config name="petstore" cashierName="jim">
        <petstore:pooled-connection username="#[vars.username]" password="#[vars.password]" />
        <petstore:pets>
            <petstore:pet value="la tota" />
            <petstore:pet value="la porota" />
        </petstore:pets>
    </petstore:config>

    <operation name="do-get-client">
        <body>
            <petstore:get-client config-ref="petstore" />
        </body>
        <output type="string"/>
    </operation>

    <operation name="do-get-pets">
        <parameters>
            <parameter name="owner" type="string" />
        </parameters>
        <body>
            <petstore:get-pets config-ref="petstore" ownerName="#[vars.owner]" />
        </body>
        <output type="string"/>
    </operation>

    <operation name="do-get-client-with-private-operation">
        <body>
            <tns:private-do-get-client />
        </body>
        <output type="string"/>
    </operation>

    <operation name="private-do-get-client" visibility="PRIVATE">
        <body>
            <petstore:get-client config-ref="petstore" />
        </body>
        <output type="string"/>
    </operation>
</module>
