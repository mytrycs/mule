<?xml version="1.0" encoding="UTF-8"?>
<module name="module-test-connection"
        xmlns="https://schemas.zernova.dev/module"

        xmlns:petstore="https://schemas.zernova.dev/petstore"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           https://schemas.zernova.dev/module https://schemas.zernova.dev/module/current/zernova-module.xsd
           https://schemas.zernova.dev/petstore https://schemas.zernova.dev/petstore/current/zernova-petstore.xsd ">

    <property name="someUserConfig" type="string"/>
    <property name="somePassConfig" type="string"/>

    <petstore:config name="petstore-config" cashierName="cashierName">
        <petstore:connection username="#[vars.someUserConfig]" password="#[vars.somePassConfig]"/>
        <petstore:pets>
            <petstore:pet value="Dog"/>
        </petstore:pets>
    </petstore:config>
</module>
