<?xml version="1.0" encoding="UTF-8"?>
<module name="module-using-errormapping"
        xmlns="https://schemas.zernova.dev/module"
        xmlns:petstore="https://schemas.zernova.dev/petstore"
        xmlns:zernova="https://schemas.zernova.dev/core"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           https://schemas.zernova.dev/module https://schemas.zernova.dev/module/current/zernova-module.xsd
           https://schemas.zernova.dev/petstore https://schemas.zernova.dev/petstore/current/zernova-petstore.xsd
           https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd">

    <property name="username" type="string" />

    <petstore:config name="config" cashierName="cashierName">
        <petstore:connection username="#[vars.username]" password="doe"/>
        <petstore:pets>
            <petstore:pet value="Dog"/>
        </petstore:pets>
    </petstore:config>

    <operation name="fail-raise-error">
        <parameters>
            <parameter name="petNames" type="string"/>
            <parameter name="failExpression" type="boolean"/>
        </parameters>
        <body>
            <zernova:choice>
                <!-- TODO MULE-13638: Partial fix until there's a way to make the calling to petstore:fail breaks differently depending on the 'petNames' parametrization -->
                <zernova:when expression="#[vars.failExpression]">
                    <!-- defining an expression that will always fail -->
                    <petstore:fail petNames="#[ ' ++ as Object  ]">
                        <zernova:error-mapping targetType="MODULE-USING-ERRORMAPPING:SMART_CONNECTOR_CUSTOM_ERROR_EXPRESSION" sourceType="EXPRESSION"/>
                    </petstore:fail>
                </zernova:when>
                <zernova:otherwise>
                    <petstore:fail petNames="#[vars.petNames]">
                        <zernova:error-mapping targetType="MODULE-USING-ERRORMAPPING:SMART_CONNECTOR_CUSTOM_ERROR_CONNECTIVITY" sourceType="CONNECTIVITY"/>
                    </petstore:fail>
                </zernova:otherwise>
            </zernova:choice>
        </body>
        <output type="string"/>
        <errors>
            <error type="SMART_CONNECTOR_CUSTOM_ERROR_CONNECTIVITY"/>
            <error type="SMART_CONNECTOR_CUSTOM_ERROR_EXPRESSION"/>
        </errors>
    </operation>

    <operation name="fail-by-timeout">
        <parameters>
            <parameter name="petNames" type="string"/>
        </parameters>
        <body>
            <petstore:fail petNames="#[vars.petNames]">
                <zernova:error-mapping targetType="MODULE-USING-ERRORMAPPING:SMART_CONNECTOR_CUSTOM_ERROR_TIMEOUT" sourceType="CONNECTIVITY"/>
            </petstore:fail>
        </body>
        <output type="string"/>
        <errors>
            <error type="SMART_CONNECTOR_CUSTOM_ERROR_TIMEOUT"/>
        </errors>
    </operation>

    <operation name="fail-by-security">
        <parameters>
            <parameter name="petNames" type="string"/>
        </parameters>
        <body>
            <petstore:fail petNames="#[vars.petNames]">
                <zernova:error-mapping targetType="MODULE-USING-ERRORMAPPING:SMART_CONNECTOR_CUSTOM_ERROR_SECURITY" sourceType="CONNECTIVITY"/>
            </petstore:fail>
        </body>
        <output type="string"/>
        <errors>
            <error type="SMART_CONNECTOR_CUSTOM_ERROR_SECURITY"/>
        </errors>
    </operation>

    <operation name="simple-op">
        <body>
            <zernova:set-payload value="simple operation called" />
        </body>
        <output type="string"/>
    </operation>
</module>
