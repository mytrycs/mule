<?xml version="1.0" encoding="UTF-8"?>
<module name="module-json-custom-types"
        xmlns="https://schemas.zernova.dev/module"
        xmlns:zernova="https://schemas.zernova.dev/core"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           https://schemas.zernova.dev/module https://schemas.zernova.dev/module/current/zernova-module.xsd
           https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd">

    <operation name="operation-with-custom-types">
        <parameters>
            <parameter name="value" type="Type1"/>
        </parameters>
        <body>
            <zernova:set-payload value="#[vars.value]"/>
        </body>
        <output type="Type2"/>
    </operation>

    <operation name="is-jsontype1">
        <parameters>
            <parameter name="aParameter" type="Type1"/>
        </parameters>
        <body>
            <zernova:set-payload value="#[output application/java --- vars.aParameter is {street_type: String , street_name: String} ]"/>
        </body>
        <output type="boolean"/>
    </operation>

    <operation name="is-jsontype1-content">
        <parameters>
            <parameter name="rules" type="Type1" role="CONTENT"/>
        </parameters>
        <body>
            <zernova:set-payload value="#[output application/java --- vars.rules is {street_type: String , street_name: String} ]"/>
        </body>
        <output type="boolean"/>
    </operation>

    <operation name="is-jsontype2">
        <parameters>
            <parameter name="aParameter" type="Type2"/>
        </parameters>
        <body>
            <zernova:set-payload value="#[output application/java --- vars.aParameter is {firstName: String , lastName: String, age: Number}]"/>
        </body>
        <output type="boolean"/>
    </operation>

    <operation name="get-hardcoded-type1">
        <body>
            <zernova:set-payload value="#[{ 'street_type': 'Avenue', 'street_name': 'calle 7'}]" />
        </body>
        <output type="Type1"/>
    </operation>

    <operation name="copy-jsontype1">
        <parameters>
            <parameter name="aParameter" type="Type1"/>
        </parameters>
        <body>
            <zernova:set-payload value="#[output application/java --- { 'street_type': vars.aParameter.street_type, 'street_name': vars.aParameter.street_name }]"/>
        </body>
        <output type="Type1"/>
    </operation>


    <operation name="get-hardcoded-type1-as-json">
        <body>
            <zernova:set-payload value="#[output application/json --- { 'street_type': 'Avenue', 'street_name': 'calle 7'}]" />
        </body>
        <output type="Type1"/>
    </operation>

    <operation name="check-street-is-avenue">
        <parameters>
            <parameter name="street" type="string"/>
        </parameters>
        <body>
            <zernova:set-payload value="#[output application/java --- vars.street == 'Avenue']" />
        </body>
        <output type="boolean"/>
    </operation>

    <operation name="join-string-array">
        <parameters>
            <parameter name="behaviourArray" type="TypeStringArray"/>
            <parameter name="contentArray" type="TypeStringArray" role="CONTENT"/>
        </parameters>
        <body>
            <zernova:set-variable variableName="behaviourAsString" value="#[output application/java  --- vars.behaviourArray joinBy '-']" />
            <zernova:set-variable variableName="contentAsString" value="#[output application/java  --- vars.contentArray joinBy '-']" />
            <zernova:set-payload value="#[vars.behaviourAsString ++ '_' ++ vars.contentAsString]"/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="join-arrays">
        <parameters>
            <parameter name="ids" type="ids"/>
            <parameter name="contentArray" type="TypeStringArray" role="CONTENT"/>
        </parameters>
        <body>
            <zernova:set-variable variableName="idsAsString" value="#[output application/java  --- vars.ids joinBy '-']"/>
            <zernova:set-variable variableName="contentAsString"
                               value="#[output application/java  --- vars.contentArray joinBy '-']"/>
            <zernova:set-payload value="#[vars.idsAsString ++ '_' ++ vars.contentAsString]"/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="operation-with-input-data">
        <parameters>
            <parameter name="input-data" type="input-data-type" use="REQUIRED" role="PRIMARY"/>
        </parameters>
        <body>
            <zernova:set-payload value="#[vars['input-data']]"/>
        </body>
        <output type="string"/>
    </operation>
</module>
