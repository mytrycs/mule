<?xml version="1.0" encoding="UTF-8"?>
<module name="module-global-element-default-params-with-no-use"
        xmlns="https://schemas.zernova.dev/module"
        xmlns:tns="https://schemas.zernova.dev/module-global-element-default-params-with-no-use"
        xmlns:zernova="https://schemas.zernova.dev/core"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           https://schemas.zernova.dev/module https://schemas.zernova.dev/module/current/zernova-module.xsd
           https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
           https://schemas.zernova.dev/module-global-element-default-params https://schemas.zernova.dev/module-global-element-default-params/current/zernova-module-global-element-default-params.xsd">

    <property name="moduleproperty" type="string" defaultValue="aniceproperty"/>

    <operation name="set-xml-property">
        <body>
            <zernova:set-payload value="#[vars.moduleproperty]"/>
        </body>
        <output type="string"/>
    </operation>

</module>