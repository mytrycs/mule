<?xml version="1.0" encoding="UTF-8"?>
<module name="module-async"
        xmlns="https://schemas.zernova.dev/module"
        xmlns:zernova="https://schemas.zernova.dev/core"
        xmlns:test-components="https://schemas.zernova.dev/test"
        xmlns:heisenberg="https://schemas.zernova.dev/heisenberg"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           https://schemas.zernova.dev/module https://schemas.zernova.dev/module/current/zernova-module.xsd
           https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
           https://schemas.zernova.dev/test https://schemas.zernova.dev/test/current/zernova-test.xsd
           https://schemas.zernova.dev/heisenberg https://schemas.zernova.dev/heisenberg/current/zernova-heisenberg.xsd">

    <operation name="async-non-blocking">
        <parameters>
            <parameter name="value" type="string"/>
        </parameters>
        <body>
            <zernova:async>
                <heisenberg:non-blocking/>
                <test-components:queue name="asyncResponseQueue"/>
            </zernova:async>
        </body>
        <output type="string"/>
    </operation>
    
</module>
