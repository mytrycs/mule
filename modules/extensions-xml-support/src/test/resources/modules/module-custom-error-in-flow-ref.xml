<?xml version="1.0" encoding="UTF-8"?>
<module name="module-custom-error-in-flow-ref"
        prefix="custom-error-prefix"
        namespace="http://www.mulesoft.org/schema/a/different/path/mule/module-custom-error-in-flow-ref"
        xmlns="https://schemas.zernova.dev/module"
        xmlns:zernova="https://schemas.zernova.dev/core"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           https://schemas.zernova.dev/module https://schemas.zernova.dev/module/current/zernova-module.xsd
           https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd">
    <operation name="raise-error-in-flow-ref">
        <body>
            <zernova:flow-ref name="flow"/>
        </body>
        <output type="string"/>
    </operation>

    <zernova:flow name="flow">
        <zernova:raise-error type="RAISE-ERROR-IN-FLOW-REF:CUSTOM_ERROR" description="Custom error"/>
    </zernova:flow>
</module>
