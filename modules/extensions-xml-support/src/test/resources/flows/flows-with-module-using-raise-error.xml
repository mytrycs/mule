<?xml version="1.0" encoding="UTF-8"?>
<zernova xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:module-using-raise-error="https://schemas.zernova.dev/module-using-raise-error"
      xmlns="https://schemas.zernova.dev/core"
      xsi:schemaLocation="https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
               https://schemas.zernova.dev/module-using-raise-error https://schemas.zernova.dev/module-using-raise-error/current/zernova-module-using-raise-error.xsd">

    <flow name="simple">
        <module-using-raise-error:fail-raise-error/>
        <error-handler>
            <on-error-continue type="CONNECTIVITY">
                <set-payload value="#['Could not connect: ' ++ error.description]"/>
            </on-error-continue>
            <on-error-continue>
                <set-payload value="Error."/>
            </on-error-continue>
        </error-handler>
    </flow>

    <flow name="complex">
        <module-using-raise-error:fail-raise-error custom="true"/>
        <error-handler>
            <on-error-continue type="MODULE-USING-RAISE-ERROR:SMART_CONNECTOR_CUSTOM">
                <set-payload value="#['Custom error: ' ++ error.description]"/>
            </on-error-continue>
            <on-error-continue>
                <set-payload value="Error."/>
            </on-error-continue>
        </error-handler>
    </flow>

    <flow name="complexMapping">
        <module-using-raise-error:fail-raise-error custom="true">
            <error-mapping sourceType="MODULE-USING-RAISE-ERROR:SMART_CONNECTOR_CUSTOM" targetType="APP:CUSTOM"/>
        </module-using-raise-error:fail-raise-error>
        <error-handler>
            <on-error-continue type="APP:CUSTOM">
                <set-payload value="Handled"/>
            </on-error-continue>
            <on-error-continue>
                <set-payload value="Error."/>
            </on-error-continue>
        </error-handler>
    </flow>

    <flow name="simpleWithNoHandlingFlow">
        <module-using-raise-error:fail-raise-error/>
    </flow>

    <flow name="simpleWithCustomJavaExceptionFlow">
        <module-using-raise-error:fail-custom-exception content="#[vars.food]"/>
    </flow>

</zernova>
