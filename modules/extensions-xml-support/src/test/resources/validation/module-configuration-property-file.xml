<?xml version="1.0" encoding="UTF-8"?>
<module name="module-configuration-property-file"
        
        xmlns="https://schemas.zernova.dev/module"
        xmlns:zernova="https://schemas.zernova.dev/core"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           https://schemas.zernova.dev/module https://schemas.zernova.dev/module/current/zernova-module.xsd
           https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd">

    <zernova:configuration-properties file="config.properties" />

    <operation name="op">
        <body>
            <!-- smart connectors do not support configuration properties, it will fail during validation phase-->
            <zernova:set-payload value="${aProperty}"/>
        </body>
        <output type="string"/>
    </operation>
</module>
