<?xml version="1.0" encoding="UTF-8"?>
<module name="module-parameter-required-default"
        xmlns="https://schemas.zernova.dev/module"
        xmlns:zernova="https://schemas.zernova.dev/core"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           https://schemas.zernova.dev/module https://schemas.zernova.dev/module/current/zernova-module.xsd
           https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd">

    <operation name="operation-with-parameter-required-default">
        <parameters>
            <parameter name="aWrongDefinedParameter" type="string" use="REQUIRED" defaultValue="a default value"/>
        </parameters>
        <body>
            <zernova:set-payload value="#[vars.value]"/>
        </body>
        <output type="string"/>
    </operation>
</module>
