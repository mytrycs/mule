<?xml version="1.0" encoding="UTF-8"?>
<module name="module-calling-operations-within-module-with-cycles"
        prefix="modified-prefix"
        namespace="http://www.mulesoft.org/schema/a/different/path/mule/module-calling-operations-within-module-with-cycles"
        xmlns:tns="http://www.mulesoft.org/schema/a/different/path/mule/module-calling-operations-within-module-with-cycles"

        xmlns="https://schemas.zernova.dev/module"
        xmlns:zernova="https://schemas.zernova.dev/core"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           https://schemas.zernova.dev/module https://schemas.zernova.dev/module/current/zernova-module.xsd
           https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
           http://www.mulesoft.org/schema/a/different/path/mule/module-calling-operations-within-module-with-cycles http://www.mulesoft.org/schema/a/different/path/mule/module-calling-operations-within-module-with-cycles/current/zernova-modified-prefix.xsd">


    <operation name="foreach-op1">
        <parameters>
            <parameter name="amount" type="number"/>
        </parameters>
        <body>
            <zernova:set-variable variableName="collected" value="" />
            <zernova:foreach collection="#[(1 to vars.amount) as Array]">
                <zernova:set-variable variableName="collected" value="#[vars.collected ++ payload]" />
                <tns:foreach-op2 amount="#[payload]"/>
            </zernova:foreach>
            <zernova:set-payload value="#[vars.collected]"/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="foreach-op2">
        <parameters>
            <parameter name="amount" type="number"/>
        </parameters>
        <body>
            <zernova:set-variable variableName="collected" value="" />
            <zernova:foreach collection="#[(1 to vars.amount) as Array]">
                <zernova:set-variable variableName="collected" value="#[vars.collected ++ payload]" />
                <zernova:foreach collection="#[(vars.amount to 1) as Array]">
                    <zernova:set-variable variableName="collected" value="#[vars.collected ++ payload]" />
                    <tns:foreach-op1 amount="#[payload]"/>
                </zernova:foreach>
            </zernova:foreach>
            <zernova:set-payload value="#[vars.collected]"/>
        </body>
        <output type="string"/>
    </operation>

</module>
