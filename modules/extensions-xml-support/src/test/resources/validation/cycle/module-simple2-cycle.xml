<?xml version="1.0" encoding="UTF-8"?>
<module name="module-calling-operations-within-module-with-cycles"
        prefix="modified-prefix"
        namespace="http://www.mulesoft.org/schema/a/different/path/mule/module-calling-operations-within-module-with-cycles"
        xmlns:tns="http://www.mulesoft.org/schema/a/different/path/mule/module-calling-operations-within-module-with-cycles"

        xmlns="https://schemas.zernova.dev/module"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           https://schemas.zernova.dev/module https://schemas.zernova.dev/module/current/zernova-module.xsd
           http://www.mulesoft.org/schema/a/different/path/mule/module-calling-operations-within-module-with-cycles http://www.mulesoft.org/schema/a/different/path/mule/module-calling-operations-within-module-with-cycles/current/zernova-modified-prefix.xsd">

    <operation name="op1">
        <parameters>
            <parameter name="op1Parameter" type="string"/>
        </parameters>
        <body>
            <tns:op2 op2Parameter="#['{op1 breadcrum, we need to go deeper..' ++ vars.op1Parameter ++ '}']"/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="op2">
        <parameters>
            <parameter name="op2Parameter" type="string"/>
        </parameters>
        <body>
            <tns:op3 op3Parameter="#['{op2 breadcrum, we need to go deeper..' ++ vars.op2Parameter ++ '}']"/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="op3">
        <parameters>
            <parameter name="op3Parameter" type="string"/>
        </parameters>
        <body>
            <tns:op1 op1Parameter="#['{op3 breadcrum, we need to go deeper..' ++ vars.op3Parameter ++ '}']"/>
        </body>
        <output type="string"/>
    </operation>
</module>
