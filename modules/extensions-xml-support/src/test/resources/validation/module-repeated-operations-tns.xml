<?xml version="1.0" encoding="UTF-8"?>
<module name="module-repeated-operations-tns"
        namespace="https://schemas.zernova.dev/module-repeated-operations-tns"
        xmlns="https://schemas.zernova.dev/module"
        xmlns:zernova="https://schemas.zernova.dev/core"
        xmlns:tns="https://schemas.zernova.dev/module-repeated-operations-tns"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           https://schemas.zernova.dev/module https://schemas.zernova.dev/module/current/zernova-module.xsd
           https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd
           https://schemas.zernova.dev/module-repeated-operations-tns https://schemas.zernova.dev/module-repeated-operations-tns/current/zernova-module-repeated-operations-tns.xsd">

    <operation name="repeated-operation-tns">
        <parameters>
            <parameter name="value" type="string"/>
        </parameters>
        <body>
            <zernova:set-payload value="#[vars.value]"/>
            <tns:repeated-operation/>
        </body>
        <output type="string"/>
    </operation>

    <operation name="repeated-operation-tns" visibility="PRIVATE">
        <parameters>
            <parameter name="value" type="string"/>
        </parameters>
        <body>
            <zernova:set-payload value="#[vars.value]"/>
        </body>
        <output type="string"/>
    </operation>
</module>
