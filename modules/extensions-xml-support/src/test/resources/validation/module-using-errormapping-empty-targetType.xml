<?xml version="1.0" encoding="UTF-8"?>
<module name="module-using-errormapping"
        xmlns="https://schemas.zernova.dev/module"
        xmlns:petstore="https://schemas.zernova.dev/petstore"
        xmlns:zernova="https://schemas.zernova.dev/core"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           https://schemas.zernova.dev/module https://schemas.zernova.dev/module/current/zernova-module.xsd
           https://schemas.zernova.dev/petstore https://schemas.zernova.dev/petstore/current/zernova-petstore.xsd
           https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd">

    <petstore:config name="config" cashierName="cashierName">
        <petstore:connection username="john" password="doe"/>
        <petstore:pets>
            <petstore:pet value="Dog"/>
        </petstore:pets>
    </petstore:config>

    <operation name="fail-raise-error">
        <parameters>
            <parameter name="petNames" type="string"/>
        </parameters>
        <body>
            <petstore:fail petNames="#[vars.petNames]">
                <zernova:error-mapping sourceType="CONNECTIVITY"/>
            </petstore:fail>
        </body>
        <output type="string"/>
        <errors>
            <error type="SMART_CONNECTOR_CUSTOM_ERROR_CONNECTIVITY"/>
        </errors>
    </operation>

    <operation name="fail-raise-error-nested">
        <parameters>
            <parameter name="custom" type="boolean" defaultValue="false"/>
            <parameter name="amount" type="number" defaultValue="3"/>
        </parameters>
        <body>
            <zernova:foreach collection="#[(1 to vars.amount) as Array]">
                <zernova:foreach collection="#[(vars.amount to 1) as Array]">
                    <petstore:fail petNames="#[vars.petNames]">
                        <zernova:error-mapping sourceType="CONNECTIVITY"/>
                    </petstore:fail>
                </zernova:foreach>
            </zernova:foreach>
        </body>
        <output type="string"/>
        <errors>
            <error type="SMART_CONNECTOR_CUSTOM_ERROR_CONNECTIVITY"/>
        </errors>
    </operation>

</module>
