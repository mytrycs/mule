<?xml version="1.0" encoding="UTF-8"?>
<module name="module-using-errormapping"
        xmlns="https://schemas.zernova.dev/module"
        xmlns:petstore="https://schemas.zernova.dev/petstore"
        xmlns:heisenberg="https://schemas.zernova.dev/heisenberg"
        xmlns:zernova="https://schemas.zernova.dev/core"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           https://schemas.zernova.dev/module https://schemas.zernova.dev/module/current/zernova-module.xsd
           https://schemas.zernova.dev/petstore https://schemas.zernova.dev/petstore/current/zernova-petstore.xsd
           https://schemas.zernova.dev/heisenberg https://schemas.zernova.dev/heisenberg/current/zernova-heisenberg.xsd
           https://schemas.zernova.dev/core https://schemas.zernova.dev/core/current/zernova.xsd">

    <petstore:config name="repeated-config-name" cashierName="cashierName">
        <petstore:connection username="john" password="doe"/>
        <petstore:pets>
            <petstore:pet value="Dog"/>
        </petstore:pets>
    </petstore:config>

    <petstore:config name="repeated-config-name" cashierName="cashierName">
        <petstore:connection username="john" password="doe"/>
        <petstore:pets>
            <petstore:pet value="Dog"/>
        </petstore:pets>
    </petstore:config>

    <heisenberg:config name="repeated-config-name"
                       age="50"
                       cancer="true"
                       dateOfBirth="1959-09-07T00:00:00"
                       dateOfDeath="2011-09-07T00:00:00-05:00"
                       money="0"
                       initialHealth="CANCER"
                       finalHealth="CANCER"
                       enemies="#[[]]">
        <heisenberg:monthly-incomes>
            <heisenberg:monthly-income value="12000"/>
            <heisenberg:monthly-income value="500"/>
        </heisenberg:monthly-incomes>
        <heisenberg:known-addresses>
            <heisenberg:known-address value="one address"/>
        </heisenberg:known-addresses>
    </heisenberg:config>

    <petstore:config name="ilegal-petstore-config-name_lal[\{#a" cashierName="cashierName">
        <petstore:connection username="john" password="doe"/>
        <petstore:pets>
            <petstore:pet value="Dog"/>
        </petstore:pets>
    </petstore:config>

    <petstore:config name="unique-petstore-config" cashierName="cashierName" xmlns:connection="true">
        <petstore:connection username="john" password="doe"/>
        <petstore:pets>
            <petstore:pet value="Dog"/>
        </petstore:pets>
    </petstore:config>

    <operation name="fail-raise-error">
        <parameters>
            <parameter name="petNames" type="string"/>
        </parameters>
        <body>
            <petstore:fail config-ref="unique-petstore-config" petNames="#[vars.petNames]" />
        </body>
        <output type="string"/>
    </operation>

</module>
